{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OSHEThai/HerdrOps/blob/main/Plan/reference-hosts/reference-host-profile.schema.json",
  "title": "HerdrOps reference-host profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "profileId",
    "approval",
    "environmentBinding",
    "candidatePolicy",
    "diagnosticPolicy"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvedOn", "approvalReference"],
      "properties": {
        "approvedBy": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
        "approvedOn": { "type": "string", "format": "date" },
        "approvalReference": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/OSHEThai/HerdrOps/issues/[0-9]+#issuecomment-[0-9]+$"
        }
      }
    },
    "environmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "graphicsAdapters", "activeDisplay", "herdr"],
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "machineName",
            "manufacturer",
            "model",
            "operatingSystemCaption",
            "operatingSystemVersion",
            "operatingSystemBuild",
            "architecture"
          ],
          "properties": {
            "machineName": { "type": "string", "minLength": 1 },
            "manufacturer": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "operatingSystemCaption": { "type": "string", "minLength": 1 },
            "operatingSystemVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" },
            "operatingSystemBuild": { "type": "integer", "minimum": 1 },
            "architecture": { "enum": ["x64", "arm64"] }
          }
        },
        "graphicsAdapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["displayName", "pnpDeviceId", "driverVersion"],
            "properties": {
              "displayName": { "type": "string", "minLength": 1 },
              "pnpDeviceId": { "type": "string", "pattern": "^PCI\\\\VEN_[0-9A-F]{4}&DEV_[0-9A-F]{4}.+$" },
              "driverVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)+$" }
            }
          }
        },
        "activeDisplay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activeMonitorCount",
            "adapterPnpDeviceId",
            "monitorInstanceName",
            "primaryDisplayDeviceName",
            "physicalWidthPixels",
            "physicalHeightPixels",
            "logicalWidthPixels",
            "logicalHeightPixels",
            "refreshRateHz",
            "desktopAppliedDpi",
            "scalePercent"
          ],
          "properties": {
            "activeMonitorCount": { "const": 1 },
            "adapterPnpDeviceId": { "type": "string", "pattern": "^PCI\\\\VEN_[0-9A-F]{4}&DEV_[0-9A-F]{4}.+$" },
            "monitorInstanceName": { "type": "string", "pattern": "^DISPLAY\\\\.+" },
            "primaryDisplayDeviceName": { "type": "string", "pattern": "^\\\\\\\\\\.\\\\DISPLAY[0-9]+$" },
            "physicalWidthPixels": { "type": "integer", "minimum": 1 },
            "physicalHeightPixels": { "type": "integer", "minimum": 1 },
            "logicalWidthPixels": { "type": "integer", "minimum": 1 },
            "logicalHeightPixels": { "type": "integer", "minimum": 1 },
            "refreshRateHz": { "type": "integer", "minimum": 1 },
            "desktopAppliedDpi": { "type": "integer", "minimum": 1 },
            "scalePercent": { "type": "integer", "minimum": 1 }
          }
        },
        "herdr": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "releaseId", "installPathRelativeToLocalAppData", "executableSha256"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "releaseId": { "type": "string", "minLength": 1 },
            "installPathRelativeToLocalAppData": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
            },
            "executableSha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
          }
        }
      }
    },
    "candidatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampling", "renderer", "workingSetPolicy"],
      "properties": {
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationSeconds", "intervalMilliseconds", "requiredLanguageMatrix"],
          "properties": {
            "durationSeconds": { "const": 20 },
            "intervalMilliseconds": { "const": 250 },
            "requiredLanguageMatrix": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "prefixItems": [
                { "const": "Thai" },
                { "const": "English" }
              ],
              "items": false
            }
          }
        },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "wpfProcessRenderMode"],
          "properties": {
            "policy": { "const": "software-only-process-wide" },
            "wpfProcessRenderMode": { "const": "SoftwareOnly" }
          }
        },
        "workingSetPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["combinedMaximumMebibytes", "combinedMaximumBytes", "statistic"],
          "properties": {
            "combinedMaximumMebibytes": { "const": 255 },
            "combinedMaximumBytes": { "const": 267386880 },
            "statistic": { "const": "maximum" }
          }
        }
      }
    },
    "diagnosticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excludedFromEnvironmentBinding"],
      "properties": {
        "excludedFromEnvironmentBinding": {
          "type": "array",
          "uniqueItems": true,
          "prefixItems": [
            { "const": "diagnostics.observedUtc" },
            { "const": "diagnostics.availablePhysicalMemoryBytes" },
            { "const": "diagnostics.batteryState" },
            { "const": "diagnostics.backgroundProcessCount" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
