{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "EvidenceClassification", "Issue", "Result", "Source", "Package", "Herdr", "Sessions", "MatrixCandidate", "Languages", "EvidenceBoundary"],
  "properties": {
    "SchemaVersion": { "const": 1, "type": "integer" },
    "EvidenceClassification": { "const": "Issue9RuntimeCandidate", "type": "string" },
    "Issue": { "const": 9, "type": "integer" },
    "Result": { "const": "PASS", "type": "string" },
    "Source": { "$ref": "#/$defs/source" },
    "Package": { "$ref": "#/$defs/package" },
    "Herdr": { "type": "object", "additionalProperties": false, "required": ["ReleaseId", "ExecutableSha256", "BundledSchemaSha256", "Protocol"], "properties": { "ReleaseId": { "$ref": "#/$defs/text" }, "ExecutableSha256": { "$ref": "#/$defs/sha256" }, "BundledSchemaSha256": { "$ref": "#/$defs/sha256" }, "Protocol": { "type": "string", "pattern": "^[0-9]+$" } } },
    "Sessions": { "type": "object", "additionalProperties": false, "required": ["Control", "Target"], "properties": { "Control": { "$ref": "#/$defs/sessionControl" }, "Target": { "$ref": "#/$defs/sessionTarget" } } },
    "MatrixCandidate": { "type": "object", "additionalProperties": false, "required": ["Path", "FileSha256", "PayloadSha256", "ProducerRunNonce", "EvidenceClassification", "IndependentHumanReview", "ReleaseCredit"], "properties": { "Path": { "$ref": "#/$defs/absolutePath" }, "FileSha256": { "$ref": "#/$defs/sha256" }, "PayloadSha256": { "$ref": "#/$defs/sha256" }, "ProducerRunNonce": { "$ref": "#/$defs/nonce" }, "EvidenceClassification": { "const": "RuntimeMatrixCandidate", "type": "string" }, "IndependentHumanReview": { "const": "NOT_OBSERVED", "type": "string" }, "ReleaseCredit": { "const": false, "type": "boolean" } } },
    "Languages": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/language" } },
    "EvidenceBoundary": { "type": "object", "additionalProperties": false, "required": ["Runtime", "HumanVisual", "ReleaseCredit", "OutputAuthority", "FixtureMode"], "properties": { "Runtime": { "const": "NOT_OBSERVED", "type": "string" }, "HumanVisual": { "const": "NOT_OBSERVED", "type": "string" }, "ReleaseCredit": { "const": false, "type": "boolean" }, "OutputAuthority": { "const": "RuntimeCandidate", "type": "string" }, "FixtureMode": { "type": "boolean" } } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "absolutePath": { "type": "string", "minLength": 2, "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\)" },
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["CommitSha", "TreeSha", "GitTreeClean"], "properties": { "CommitSha": { "$ref": "#/$defs/gitSha" }, "TreeSha": { "$ref": "#/$defs/gitSha" }, "GitTreeClean": { "const": true, "type": "boolean" } } },
    "package": { "type": "object", "additionalProperties": false, "required": ["IdentityPath", "IdentityFileSha256", "ReceiptSha256", "ArchivePath", "ArchiveSha256", "ManifestPath", "ManifestSha256", "AppPath", "AppSha256", "CorePath", "CoreSha256"], "properties": { "IdentityPath": { "$ref": "#/$defs/absolutePath" }, "IdentityFileSha256": { "$ref": "#/$defs/sha256" }, "ReceiptSha256": { "$ref": "#/$defs/sha256" }, "ArchivePath": { "$ref": "#/$defs/absolutePath" }, "ArchiveSha256": { "$ref": "#/$defs/sha256" }, "ManifestPath": { "$ref": "#/$defs/absolutePath" }, "ManifestSha256": { "$ref": "#/$defs/sha256" }, "AppPath": { "$ref": "#/$defs/absolutePath" }, "AppSha256": { "$ref": "#/$defs/sha256" }, "CorePath": { "$ref": "#/$defs/absolutePath" }, "CoreSha256": { "$ref": "#/$defs/sha256" } } },
    "sessionControl": { "type": "object", "additionalProperties": false, "required": ["Name", "SocketPath", "ServerIdentity"], "properties": { "Name": { "$ref": "#/$defs/text" }, "SocketPath": { "$ref": "#/$defs/absolutePath" }, "ServerIdentity": { "$ref": "#/$defs/text" } } },
    "sessionTarget": { "type": "object", "additionalProperties": false, "required": ["Name", "SocketPath", "Reference"], "properties": { "Name": { "$ref": "#/$defs/text" }, "SocketPath": { "$ref": "#/$defs/absolutePath" }, "Reference": { "$ref": "#/$defs/text" } } },
    "page": { "type": "object", "additionalProperties": false, "required": ["Name", "Language", "UiCapturePath", "UiCaptureSha256", "StateSha256", "WorkspaceId", "ProjectId", "AgentId", "TaskId", "AgentStatus", "PaneId"], "properties": { "Name": { "enum": ["Overview", "LiveOrganization", "AgentDetail"] }, "Language": { "enum": ["Thai", "English"] }, "UiCapturePath": { "$ref": "#/$defs/absolutePath" }, "UiCaptureSha256": { "$ref": "#/$defs/sha256" }, "StateSha256": { "$ref": "#/$defs/sha256" }, "WorkspaceId": { "$ref": "#/$defs/text" }, "ProjectId": { "$ref": "#/$defs/text" }, "AgentId": { "$ref": "#/$defs/text" }, "TaskId": { "$ref": "#/$defs/text" }, "AgentStatus": { "$ref": "#/$defs/text" }, "PaneId": { "$ref": "#/$defs/text" } } },
    "relativePath": { "type": "string", "minLength": 1 },
    "selection": { "type": "object", "additionalProperties": false, "required": ["WorkspaceId", "ProjectId", "AgentId", "TaskId", "AgentStatus", "PaneId", "StateSha256", "Source"], "properties": { "WorkspaceId": { "$ref": "#/$defs/text" }, "ProjectId": { "$ref": "#/$defs/text" }, "AgentId": { "$ref": "#/$defs/text" }, "TaskId": { "$ref": "#/$defs/text" }, "AgentStatus": { "$ref": "#/$defs/text" }, "PaneId": { "$ref": "#/$defs/text" }, "StateSha256": { "$ref": "#/$defs/sha256" }, "Source": { "const": "CoreSnapshot", "type": "string" } } },
    "lifecycle": { "type": "object", "additionalProperties": false, "required": ["DashboardClosed", "CoreConnectedAfterDashboardClose", "DisconnectObserved", "ReconnectObserved", "ReconciliationObserved", "EventAStateSha256", "EventBStateSha256", "ReconciledStateSha256", "ControlServerSurvivedTargetRestart"], "properties": { "DashboardClosed": { "const": true, "type": "boolean" }, "CoreConnectedAfterDashboardClose": { "const": true, "type": "boolean" }, "DisconnectObserved": { "const": true, "type": "boolean" }, "ReconnectObserved": { "const": true, "type": "boolean" }, "ReconciliationObserved": { "const": true, "type": "boolean" }, "EventAStateSha256": { "$ref": "#/$defs/sha256" }, "EventBStateSha256": { "$ref": "#/$defs/sha256" }, "ReconciledStateSha256": { "$ref": "#/$defs/sha256" }, "ControlServerSurvivedTargetRestart": { "const": true, "type": "boolean" } } },
    "language": { "type": "object", "additionalProperties": false, "required": ["Language", "EvidenceRunNonce", "RuntimeEvidenceDirectory", "UiEvidenceDirectory", "UiReceiptPath", "UiReceiptSha256", "SideBySideCaptureSha256", "Pages", "Selection", "Lifecycle"], "properties": { "Language": { "enum": ["Thai", "English"] }, "EvidenceRunNonce": { "$ref": "#/$defs/nonce" }, "RuntimeEvidenceDirectory": { "$ref": "#/$defs/absolutePath" }, "UiEvidenceDirectory": { "$ref": "#/$defs/absolutePath" }, "UiReceiptPath": { "$ref": "#/$defs/absolutePath" }, "UiReceiptSha256": { "$ref": "#/$defs/sha256" }, "SideBySideCaptureSha256": { "$ref": "#/$defs/sha256" }, "Pages": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/page" } }, "Selection": { "$ref": "#/$defs/selection" }, "Lifecycle": { "$ref": "#/$defs/lifecycle" } }
    }
  }
}
