{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdrops.invalid/schemas/v0.2/issue10-production-binding.schema.json",
  "title": "HerdrOps v0.2 Issue #10 production widget binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "EvidenceClassification", "Issue", "EvidenceRoot", "RunNonce", "EvidenceStartedUtc", "Source", "GateReport", "CoreRuntimeReport", "Package", "Performance", "SoakReceipt", "Runtime", "EvidenceBoundary"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "EvidenceClassification": { "const": "Issue10ProductionBinding" },
    "Issue": { "const": 10 },
    "EvidenceRoot": { "type": "string", "minLength": 1 },
    "RunNonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "EvidenceStartedUtc": { "type": "string", "minLength": 1 },
    "Source": { "$ref": "#/$defs/source" },
    "GateReport": { "$ref": "#/$defs/artifact" },
    "CoreRuntimeReport": { "$ref": "#/$defs/artifact" },
    "Package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Identity", "IdentityReceiptSha256", "Archive", "Manifest", "App", "Core"],
      "properties": {
        "Identity": { "$ref": "#/$defs/artifact" },
        "IdentityReceiptSha256": { "$ref": "#/$defs/sha" },
        "Archive": { "$ref": "#/$defs/artifact" },
        "Manifest": { "$ref": "#/$defs/artifact" },
        "App": { "$ref": "#/$defs/artifact" },
        "Core": { "$ref": "#/$defs/artifact" }
      }
    },
    "Performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Receipt", "RawSource"],
      "properties": {
        "Receipt": { "$ref": "#/$defs/artifact" },
        "RawSource": { "$ref": "#/$defs/artifact" }
      }
    },
    "SoakReceipt": { "$ref": "#/$defs/artifact" },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HerdrExecutable", "ControlSessionIdentity", "TargetSessionIdentity"],
      "properties": {
        "HerdrExecutable": { "$ref": "#/$defs/artifact" },
        "ControlSessionIdentity": { "type": "string", "minLength": 1 },
        "TargetSessionIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "EvidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Runtime", "Human", "Release", "CreditGranted"],
      "properties": {
        "Runtime": { "const": "NOT_OBSERVED" },
        "Human": { "const": "NOT_OBSERVED" },
        "Release": { "const": "NOT_OBSERVED" },
        "CreditGranted": { "const": false }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CommitSha", "TreeSha"],
      "properties": {
        "CommitSha": { "$ref": "#/$defs/commit" },
        "TreeSha": { "$ref": "#/$defs/commit" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Path", "Sha256"],
      "properties": {
        "Path": { "type": "string", "minLength": 1 },
        "Sha256": { "$ref": "#/$defs/sha" }
      }
    }
  }
}
