{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdrops.local/schema/v0.7/human-design-review.schema.json",
  "title": "HerdrOps v0.7 Issue #35 Human Design and Accessibility Review Manifest Schema",
  "description": "Versioned, fail-closed manifest that binds a human design and accessibility review to an exact WPF build, commit, run and artifact hashes, a named reviewer, complete TH/EN page coverage, 100/125/150% scale captures, a per-page accessibility checklist, Widget variant semantic review, and an explicit acceptance of the Live Organization Review-to-Done divergence. A manifest only verifies when every required slot is present, non-empty, well-formed and hash-bound; checkbox-only signoff is rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$id",
    "schemaVersion",
    "contract",
    "reviewStatus",
    "reviewer",
    "provenance",
    "uiUnderReview",
    "captures",
    "pages",
    "widgets",
    "accessibleEvidence",
    "declarations"
  ],
  "properties": {
    "$id": {
      "const": "https://herdrops.local/schema/v0.7/human-design-review.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "version", "productId", "immutableReferenceSet", "designContract"],
      "properties": {
        "issue": { "const": 35 },
        "version": { "const": "0.7.0" },
        "productId": { "const": "HerdrOps" },
        "immutableReferenceSet": { "const": "docs/design/reference/*.png" },
        "designContract": { "const": "Plan/DESIGN-CONTRACT.md" }
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["Draft", "Pending", "Accepted", "Rejected"]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "organization", "independent", "signatureDate", "signatory"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 },
        "organization": { "type": "string", "minLength": 2 },
        "independent": { "type": "boolean" },
        "signatureDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "signatory": { "type": "string", "minLength": 4 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundCommitSha256", "runHash", "artifactHash", "hashAlgorithm", "canonicalRunDescriptor"],
      "properties": {
        "boundCommitSha256": { "$ref": "#/$defs/sha256" },
        "runHash": { "$ref": "#/$defs/sha256" },
        "artifactHash": { "$ref": "#/$defs/sha256" },
        "hashAlgorithm": { "const": "SHA-256" },
        "canonicalRunDescriptor": { "type": "string", "minLength": 8 }
      }
    },
    "uiUnderReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceKind", "wpfBuild", "hostOs", "hostResolutionWidth", "hostResolutionHeight", "dpiScaleFactor", "captureTool", "observedWindow", "captureDate"],
      "properties": {
        "surfaceKind": { "const": "Observed WPF build" },
        "wpfBuild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assembly", "branch", "commitSha256", "configuration"],
          "properties": {
            "assembly": { "const": "HerdrOps.App" },
            "branch": { "type": "string", "minLength": 2 },
            "commitSha256": { "$ref": "#/$defs/sha256" },
            "configuration": { "enum": ["Release", "Debug"] }
          }
        },
        "hostOs": { "type": "string", "minLength": 3 },
        "hostResolutionWidth": { "type": "integer", "minimum": 1 },
        "hostResolutionHeight": { "type": "integer", "minimum": 1 },
        "dpiScaleFactor": { "type": "integer", "enum": [100, 125, 150] },
        "captureTool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "runtime", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "runtime": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 2 }
          }
        },
        "observedWindow": { "type": "string", "minLength": 2 },
        "captureDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "captures": {
      "type": "array",
      "items": { "$ref": "#/$defs/capture" }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "live-organization", "realtime-activity", "delegation-graph", "agent-detail", "task-alignment", "file-activity", "compliance-queue", "evaluation", "daily-summary"],
      "properties": {
        "overview": { "$ref": "#/$defs/pageReview" },
        "live-organization": { "$ref": "#/$defs/liveOrganizationReview" },
        "realtime-activity": { "$ref": "#/$defs/pageReview" },
        "delegation-graph": { "$ref": "#/$defs/pageReview" },
        "agent-detail": { "$ref": "#/$defs/pageReview" },
        "task-alignment": { "$ref": "#/$defs/pageReview" },
        "file-activity": { "$ref": "#/$defs/pageReview" },
        "compliance-queue": { "$ref": "#/$defs/pageReview" },
        "evaluation": { "$ref": "#/$defs/pageReview" },
        "daily-summary": { "$ref": "#/$defs/pageReview" }
      }
    },
    "widgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Compact", "Normal", "Expanded", "FloatingMini", "FloatingVertical", "Notification", "AgentDetailPopup", "DashboardPreview"],
      "properties": {
        "Compact": { "$ref": "#/$defs/widgetReview" },
        "Normal": { "$ref": "#/$defs/widgetReview" },
        "Expanded": { "$ref": "#/$defs/widgetReview" },
        "FloatingMini": { "$ref": "#/$defs/widgetReview" },
        "FloatingVertical": { "$ref": "#/$defs/widgetReview" },
        "Notification": { "$ref": "#/$defs/widgetReview" },
        "AgentDetailPopup": { "$ref": "#/$defs/widgetReview" },
        "DashboardPreview": { "$ref": "#/$defs/widgetReview" }
      }
    },
    "accessibleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrastManualChecks", "manualEvidenceSlots"],
      "properties": {
        "contrastManualChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contrastCheck" }
        },
        "manualEvidenceSlots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/manualEvidenceSlot" }
        }
      }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noAcceptedCaptureInPreparation", "humanReviewClaimed", "runtimeClaims", "releaseClaims", "preparationBoundary"],
      "properties": {
        "noAcceptedCaptureInPreparation": { "const": true },
        "humanReviewClaimed": { "type": "boolean" },
        "runtimeClaims": { "enum": ["NOT OBSERVED", "OBSERVED"] },
        "releaseClaims": { "enum": ["NOT PRODUCED", "PRODUCED"] },
        "preparationBoundary": { "const": "PREPARATION/Static-Contract-Synthetic" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewStatus": { "enum": ["Draft", "Pending", "Rejected"] }
        }
      },
      "then": {
        "properties": {
          "declarations": {
            "properties": {
              "humanReviewClaimed": { "const": false },
              "runtimeClaims": { "const": "NOT OBSERVED" },
              "releaseClaims": { "const": "NOT PRODUCED" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewStatus": { "const": "Accepted" }
        }
      },
      "then": {
        "properties": {
          "reviewer": {
            "properties": {
              "independent": { "const": true }
            }
          },
          "declarations": {
            "properties": {
              "humanReviewClaimed": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "language": {
      "type": "string",
      "enum": ["th", "en"]
    },
    "scaleKey": {
      "type": "integer",
      "enum": [100, 125, 150]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "width", "height", "language", "kind", "refersToReference"],
      "properties": {
        "relativePath": {
          "type": "string",
          "pattern": "^captures/((th|en)/(pages/[a-z0-9-]+-(100|125|150)\\.png|widgets/[a-z0-9-]+-native\\.png|contact-sheets/[a-z0-9-]+\\.png)|contact-sheets/[a-z0-9-]+\\.png|README-placeholder)$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "language": { "$ref": "#/$defs/language" },
        "kind": { "type": "string", "enum": ["page", "widget-variant", "dashboard-preview", "contact-sheet"] },
        "refersToReference": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.[a-z]+$" }
      }
    },
    "pageScaleCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["100", "125", "150"],
      "properties": {
        "100": { "$ref": "#/$defs/scaleCapture" },
        "125": { "$ref": "#/$defs/scaleCapture" },
        "150": { "$ref": "#/$defs/scaleCapture" }
      }
    },
    "scaleCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureRef", "sha256"],
      "properties": {
        "captureRef": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pageReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageCoverage", "accessibility"],
      "properties": {
        "languageCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["th", "en"],
          "properties": {
            "th": { "$ref": "#/$defs/pageScaleCoverage" },
            "en": { "$ref": "#/$defs/pageScaleCoverage" }
          }
        },
        "accessibility": { "$ref": "#/$defs/accessibilityChecklist" }
      }
    },
    "liveOrganizationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languageCoverage", "accessibility", "roleDivergence"],
      "properties": {
        "languageCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["th", "en"],
          "properties": {
            "th": { "$ref": "#/$defs/pageScaleCoverage" },
            "en": { "$ref": "#/$defs/pageScaleCoverage" }
          }
        },
        "accessibility": { "$ref": "#/$defs/accessibilityChecklist" },
        "roleDivergence": { "$ref": "#/$defs/reviewToDoneDivergence" }
      }
    },
    "accessibilityChecklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboardFocusVisible", "focusOrderValid", "automationNamesPresent", "thaiTextNoClipping", "reducedMotionSupported", "screenReaderSmoke"],
      "properties": {
        "keyboardFocusVisible": { "$ref": "#/$defs/checkWithEvidence" },
        "focusOrderValid": { "$ref": "#/$defs/checkWithEvidence" },
        "automationNamesPresent": { "$ref": "#/$defs/checkWithEvidence" },
        "thaiTextNoClipping": { "$ref": "#/$defs/checkWithEvidence" },
        "reducedMotionSupported": { "$ref": "#/$defs/checkWithEvidence" },
        "screenReaderSmoke": { "$ref": "#/$defs/checkWithEvidence" }
      }
    },
    "checkWithEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "evidence"],
      "properties": {
        "passed": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundSha256", "note"],
      "properties": {
        "boundSha256": { "$ref": "#/$defs/sha256" },
        "note": { "type": "string", "minLength": 8 }
      }
    },
    "reviewToDoneDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepts", "evidence"],
      "properties": {
        "accepts": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "widgetReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturesRef", "semantics", "sharedStateAccepted", "evidence"],
      "properties": {
        "capturesRef": { "type": "string", "minLength": 1 },
        "semantics": { "$ref": "#/$defs/evidenceLink" },
        "sharedStateAccepted": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidenceLink" }
      }
    },
    "contrastCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "foreground", "background", "ratio", "measured", "boundSha256"],
      "properties": {
        "label": { "type": "string", "minLength": 2 },
        "foreground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "ratio": { "type": "number", "exclusiveMinimum": 1.0 },
        "measured": { "type": "boolean" },
        "boundSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "manualEvidenceSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "observation", "boundSha256"],
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "observation": { "type": "string", "minLength": 8 },
        "boundSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}