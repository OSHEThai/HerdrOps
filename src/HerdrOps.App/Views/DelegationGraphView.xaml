<!-- Hallmark · macrostructure: Map/Diagram · genre: operational atmospheric · palette: navy/blue · pre-emit critique: P5 H5 E4 S5 R5 V4 · slop: pass (WPF-applicable gates) -->
<UserControl x:Class="HerdrOps.App.Views.DelegationGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             ClipToBounds="True"
             Loaded="OnLoaded"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />

        <DrawingBrush x:Key="DelegationGridBrush"
                      TileMode="Tile"
                      Viewbox="0,0,20,20"
                      ViewboxUnits="Absolute"
                      Viewport="0,0,20,20"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H20 V20 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource HerdrOps.Brush.Border}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="DelegationIconButton"
               TargetType="Button"
               BasedOn="{StaticResource HerdrOps.Style.ChromeButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
        </Style>

        <Style x:Key="DelegationTaskItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TaskBorder"
                                Padding="8,7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TaskBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter TargetName="TaskBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TaskBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                <Setter TargetName="TaskBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelegationNodeItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Opacity" Value="{Binding Opacity}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NodeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NodeBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                                <Setter TargetName="NodeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NodeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.Primary}" />
                                <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NodeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelegationAccessibleItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="AccessibleBorder"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccessibleBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccessibleBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter TargetName="AccessibleBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="AccessibleBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                <Setter TargetName="AccessibleBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelegationDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="DelegationRoot" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SourceRow" Height="26" />
            <RowDefinition x:Name="SummaryRow" Height="104" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Padding="8,2"
                    VerticalAlignment="Top"
                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                <TextBlock Tag="DelegationLanguageCheck"
                           Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="{Binding ProjectLabel}" />
            </Border>
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Top"
                       Tag="DelegationLanguageCheck"
                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                       FontSize="11"
                       Text="{Binding SourceLabel}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4"
                       MaxWidth="560"
                       VerticalAlignment="Top"
                       Tag="DelegationLanguageCheck"
                       automation:AutomationProperties.Name="{Binding [DelegationEvidenceBoundaryAutomation], Source={x:Static localization:UiLanguageService.Shared}}"
                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                       FontSize="10"
                       Text="{Binding EvidenceBoundary}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding EvidenceBoundary}" />
        </Grid>

        <ItemsControl x:Name="DelegationSummaryRegion"
                      Grid.Row="1"
                      ItemsSource="{Binding SummaryCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,10,0"
                            Padding="13,10"
                            Style="{DynamicResource HerdrOps.Style.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Tag="DelegationLanguageCheck"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Text="{Binding Value}" />
                                <TextBlock Tag="DelegationLanguageCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                           FontSize="9"
                                           Text="{Binding Detail}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                       FontSize="22"
                                       Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                       Text="{Binding IconGlyph}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TaskTreeColumn" Width="238" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition x:Name="DetailColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TaskTreeRegion"
                    Grid.Column="0"
                    Padding="0"
                    Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,10" VerticalAlignment="Center">
                        <TextBlock Tag="DelegationLanguageCheck"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding [DelegationTaskTreeTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Tag="DelegationLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="10"
                                   Text="{Binding [DelegationTaskTreeSubtitle], Source={x:Static localization:UiLanguageService.Shared}}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource HerdrOps.Brush.Border}" />
                    <ListBox x:Name="TaskTreeList"
                             Grid.Row="2"
                             Margin="8"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource DelegationTaskItem}"
                             ItemsSource="{Binding TaskTreeItems}"
                             SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                             automation:AutomationProperties.Name="{Binding [DelegationTaskTreeAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{Binding IndentWidth}" />
                                    <Border Grid.Column="1"
                                            Width="22"
                                            Height="22"
                                            Background="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                            CornerRadius="5">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                                   FontSize="11"
                                                   Text="&#xE8B7;" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="6,0">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                   FontSize="9"
                                                   Text="{Binding Subtitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="3"
                                            MinWidth="32"
                                            Padding="5,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                            CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                                   FontSize="9"
                                                   Text="{Binding Count}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition x:Name="TimelineRow" Height="176" />
                </Grid.RowDefinitions>

                <Border x:Name="DelegationGraphRegion"
                        Grid.Row="0"
                        Padding="0"
                        Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Tag="DelegationLanguageCheck"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding [DelegationGraphTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <Border Margin="8,0,0,0"
                                        Padding="6,2"
                                        Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                                        CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                    <TextBlock Tag="DelegationLanguageCheck"
                                               Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Text="{Binding [DelegationCurrentBadge], Source={x:Static localization:UiLanguageService.Shared}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AccessibleViewButton"
                                        Style="{StaticResource DelegationIconButton}"
                                        Click="OnAccessibleViewClick"
                                        automation:AutomationProperties.Name="{Binding [DelegationAccessibleView], Source={x:Static localization:UiLanguageService.Shared}}">
                                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="15"
                                               Text="&#xE8FD;" />
                                </Button>
                                <Button x:Name="FitButton"
                                        Style="{StaticResource DelegationIconButton}"
                                        Click="OnFitClick"
                                        automation:AutomationProperties.Name="{Binding [DelegationFit], Source={x:Static localization:UiLanguageService.Shared}}">
                                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="15"
                                               Text="&#xE9A6;" />
                                </Button>
                                <Button x:Name="ZoomOutButton"
                                        Style="{StaticResource DelegationIconButton}"
                                        Click="OnZoomOutClick"
                                        automation:AutomationProperties.Name="{Binding [DelegationZoomOut], Source={x:Static localization:UiLanguageService.Shared}}">
                                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="16"
                                               Text="&#xE738;" />
                                </Button>
                                <Border MinWidth="48"
                                        Height="40"
                                        Margin="2,0"
                                        Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                                    <TextBlock x:Name="ZoomLabel"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="100%" />
                                </Border>
                                <Button x:Name="ZoomInButton"
                                        Style="{StaticResource DelegationIconButton}"
                                        Click="OnZoomInClick"
                                        automation:AutomationProperties.Name="{Binding [DelegationZoomIn], Source={x:Static localization:UiLanguageService.Shared}}">
                                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="16"
                                               Text="&#xE710;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource HerdrOps.Brush.Border}" />

                        <Grid Grid.Row="2">
                            <Grid x:Name="VisualGraphRegion">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAccessibleView}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border x:Name="GraphViewport"
                                        Margin="8"
                                        Background="{StaticResource DelegationGridBrush}"
                                        ClipToBounds="True"
                                        Cursor="SizeAll"
                                        PreviewMouseLeftButtonDown="OnGraphMouseDown"
                                        PreviewMouseLeftButtonUp="OnGraphMouseUp"
                                        PreviewMouseMove="OnGraphMouseMove"
                                        PreviewMouseWheel="OnGraphMouseWheel"
                                        LostMouseCapture="OnGraphLostMouseCapture"
                                        automation:AutomationProperties.Name="{Binding [DelegationGraphAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                                    <Grid x:Name="GraphCanvasHost"
                                          Width="920"
                                          Height="500"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          RenderTransformOrigin="0,0">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1" />
                                                <TranslateTransform x:Name="GraphTranslate" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <ItemsControl IsHitTestVisible="False"
                                                      ItemsSource="{Binding GraphEdges}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="920" Height="500" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas Width="920" Height="500"
                                                            Opacity="{Binding Opacity}">
                                                        <Line X1="{Binding X1}"
                                                              Y1="{Binding Y1}"
                                                              X2="{Binding X2}"
                                                              Y2="{Binding Y2}"
                                                              Stroke="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                              StrokeThickness="2" />
                                                        <Ellipse Canvas.Left="{Binding X2}"
                                                                 Canvas.Top="{Binding Y2}"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Margin="-3.5,-3.5,0,0"
                                                                 Fill="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" />
                                                        <Border Canvas.Left="{Binding LabelX}"
                                                                Canvas.Top="{Binding LabelY}"
                                                                MaxWidth="116"
                                                                Padding="5,2"
                                                                Background="{DynamicResource HerdrOps.Brush.Background}"
                                                                BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                                            <TextBlock Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                                       FontSize="8"
                                                                       Text="{Binding Relationship}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ListBox x:Name="GraphNodeList"
                                                 Width="920"
                                                 Height="500"
                                                 Padding="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                                 ItemContainerStyle="{StaticResource DelegationNodeItem}"
                                                 ItemsSource="{Binding GraphNodes}"
                                                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                                 SelectionChanged="OnGraphNodeSelectionChanged">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="920" Height="500" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30"
                                                                Height="30"
                                                                Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                                                CornerRadius="15">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Initials}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                            <TextBlock FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                                       FontSize="8"
                                                                       Text="{Binding Role}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                                <Ellipse Width="6"
                                                                         Height="6"
                                                                         Fill="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                                                <TextBlock Margin="4,-2,0,0"
                                                                           Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                                                           FontSize="8"
                                                                           Text="{Binding Status}" />
                                                                <TextBlock Margin="7,-2,0,0"
                                                                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                                           FontSize="8"
                                                                           Text="{Binding TaskCount}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <ListBox x:Name="AccessibleNodeList"
                                     Margin="10"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     KeyboardNavigation.DirectionalNavigation="Cycle"
                                     ItemContainerStyle="{StaticResource DelegationAccessibleItem}"
                                     ItemsSource="{Binding AccessibleItems}"
                                     SelectedItem="{Binding SelectedAccessibleItem, Mode=TwoWay}"
                                     SelectionChanged="OnAccessibleNodeSelectionChanged"
                                     automation:AutomationProperties.Name="{Binding [DelegationAccessibleAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAccessibleView}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                                       Text="{Binding Status}" />
                                            <TextBlock Grid.Column="3"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                                       Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Padding="24"
                                    Background="{DynamicResource HerdrOps.Brush.Background}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGraph}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="34"
                                               Foreground="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                               Text="&#xE8FA;" />
                                    <TextBlock Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               Tag="DelegationLanguageCheck"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Text="{Binding [DelegationEmptyTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock MaxWidth="500"
                                               Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Tag="DelegationLanguageCheck"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="11"
                                               Text="{Binding [DelegationEmptyDetail], Source={x:Static localization:UiLanguageService.Shared}}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Tag="DelegationLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="9"
                                   Text="{Binding [DelegationKeyboardHint], Source={x:Static localization:UiLanguageService.Shared}}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border x:Name="DelegationTimelineRegion"
                        Grid.Row="2"
                        Padding="0"
                        Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="14,7" VerticalAlignment="Center">
                            <TextBlock Tag="DelegationLanguageCheck"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding [DelegationTimelineTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="DelegationLanguageCheck"
                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                       FontSize="9"
                                       Text="{Binding [DelegationTimelineSubtitle], Source={x:Static localization:UiLanguageService.Shared}}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource HerdrOps.Brush.Border}" />
                        <ListBox x:Name="TimelineList"
                                 Grid.Row="2"
                                 Margin="8,7"
                                 Padding="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Timeline}"
                                 automation:AutomationProperties.Name="{Binding [DelegationTimelineAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="204"
                                            Margin="0,0,8,0"
                                            Padding="10,7"
                                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7"
                                                         Height="7"
                                                         Fill="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="6,0"
                                                           Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Kind}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                           FontSize="9"
                                                           Text="{Binding Time}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,5,0,0"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding TaskId}" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                       FontSize="9"
                                                       Text="{Binding Disposition}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="DelegationDetailRegion"
                    Grid.Column="4"
                    Padding="0"
                    Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Tag="DelegationLanguageCheck"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding [DelegationDetailTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Border Grid.Column="1"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                            <TextBlock Tag="DelegationLanguageCheck"
                                       Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Text="{Binding [DelegationNodeBadge], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource HerdrOps.Brush.Border}" />
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44"
                                        Height="44"
                                        Background="{Binding SelectedDetail.StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                        CornerRadius="22">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDetail.Initials}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="7,1,0,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDetail.Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{Binding SelectedDetail.StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock Margin="5,-2,0,0"
                                                   Foreground="{Binding SelectedDetail.StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                                   FontSize="10"
                                                   Text="{Binding SelectedDetail.Status}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Height="1"
                                    Margin="0,13"
                                    Background="{DynamicResource HerdrOps.Brush.Border}" />

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Style="{StaticResource DelegationDetailLabel}"
                                               Text="{Binding [DelegationLabelRole], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock FontSize="11"
                                               Text="{Binding SelectedDetail.Role}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource DelegationDetailLabel}"
                                               Text="{Binding [DelegationLabelCurrentTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                               FontSize="11"
                                               Text="{Binding SelectedDetail.CurrentTask}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Style="{StaticResource DelegationDetailLabel}"
                                               Text="{Binding [DelegationLabelProgress], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock FontSize="11" Text="{Binding SelectedDetail.Progress}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource DelegationDetailLabel}"
                                               Text="{Binding [DelegationLabelLastObserved], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock FontSize="10"
                                               Text="{Binding SelectedDetail.LastObserved}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Margin="0,5,0,0"
                                       Tag="DelegationLanguageCheck"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       Text="{Binding [DelegationAssignmentContract], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <Border Margin="0,6,0,0"
                                    Padding="10"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <TextBlock FontSize="10"
                                           Text="{Binding SelectedDetail.AssignmentSummary}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Margin="0,13,0,0"
                                       Tag="DelegationLanguageCheck"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       Text="{Binding [DelegationLatestHandoff], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                       FontSize="10"
                                       Text="{Binding SelectedDetail.LastHandoff}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,13,0,0"
                                       Tag="DelegationLanguageCheck"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       Text="{Binding [DelegationRelatedTasks], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <ItemsControl Margin="0,5,0,0"
                                          ItemsSource="{Binding SelectedDetail.TaskIds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4"
                                                Padding="8,4"
                                                Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                                                CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                                       FontSize="10"
                                                       Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,13,0,0"
                                       Tag="DelegationLanguageCheck"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       Text="{Binding [DelegationLabelProvenance], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                       FontFamily="Consolas"
                                       FontSize="9"
                                       Text="{Binding SelectedDetail.Provenance}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedDetail.Provenance}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
