<UserControl x:Class="HerdrOps.App.Views.DailySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             MinWidth="640"
             MinHeight="480"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             FontFamily="{DynamicResource HerdrOps.FontFamily.UI}"
             automation:AutomationProperties.Name="{Binding BoundaryLabel}"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />
        <Style x:Key="SummaryCard" BasedOn="{StaticResource HerdrOps.Style.Card}" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="SectionCard" BasedOn="{StaticResource HerdrOps.Style.Card}" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style x:Key="SmallCaption" BasedOn="{StaticResource HerdrOps.Style.Text.Caption}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DailySummaryScrollViewer"
                  Padding="16,14,16,18"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border x:Name="DailySummaryEvidenceBoundary"
                    Padding="12,9"
                    Margin="0,0,0,12"
                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}"
                    automation:AutomationProperties.Name="{Binding BoundaryLabel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                               FontSize="17"
                               Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                               Text="&#xE946;" />
                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceLabel}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="11"
                                   Text="{Binding BoundaryLabel}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource SmallCaption}"
                                   Text="{Binding [DailySummaryDateLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontWeight="SemiBold"
                                   Text="{Binding DateLabel}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl x:Name="DailySummarySummaryCardsRegion"
                          ItemsSource="{Binding SummaryCards}"
                          automation:AutomationProperties.Name="{Binding [DailySummaryPageTitle], Source={x:Static localization:UiLanguageService.Shared}}"
                          automation:AutomationProperties.HelpText="{Binding SourceSetLabel}"
                          ToolTip="{Binding SourceSetLabel}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="250" ItemHeight="126" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SummaryCard}"
                                Focusable="True"
                                automation:AutomationProperties.Name="{Binding Title}"
                                automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                ToolTip="{Binding SourceProvenanceLabel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="12"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="29"
                                               FontWeight="SemiBold"
                                               Text="{Binding Value}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                               FontSize="11"
                                               Text="{Binding Detail}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontFamily="Consolas"
                                               FontSize="8"
                                               Text="{Binding SourceProvenanceLabel}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SourceProvenanceLabel}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Background="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                        CornerRadius="19"
                                        Opacity="0.9">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="18"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                               Text="{Binding IconGlyph}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel>
                <Border x:Name="DailySummaryHighlightsRegion" Width="420" Style="{StaticResource SectionCard}" automation:AutomationProperties.Name="{Binding [DailySummaryHighlightsTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryHighlightsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Highlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5"
                                          Focusable="True"
                                          automation:AutomationProperties.Name="{Binding Summary}"
                                          automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                          ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="15" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" Text="&#xE73E;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding SourceLabel}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                       FontFamily="Consolas"
                                                       FontSize="8"
                                                       Text="{Binding SourceProvenanceLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceProvenanceLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [DailySummarySourceLinks], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DailySummaryStrengthsRegion" Width="420" Style="{StaticResource SectionCard}" automation:AutomationProperties.Name="{Binding [DailySummaryStrengthsTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryStrengthsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Strengths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5"
                                          Focusable="True"
                                          automation:AutomationProperties.Name="{Binding Summary}"
                                          automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                          ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="15" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" Text="&#xE73E;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <ItemsControl Margin="0,2,0,0"
                                                          ItemsSource="{Binding SourceIds}"
                                                          AutomationProperties.Name="{Binding SourceLabel}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="9"
                                                                   Text="{Binding}"
                                                                   AutomationProperties.Name="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                       FontFamily="Consolas"
                                                       FontSize="8"
                                                       Text="{Binding SourceProvenanceLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceProvenanceLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="DailySummaryAreasRegion" Width="420" Style="{StaticResource SectionCard}" automation:AutomationProperties.Name="{Binding [DailySummaryAreasTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryAreasTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding AreasToImprove}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5"
                                          Focusable="True"
                                          automation:AutomationProperties.Name="{Binding Summary}"
                                          automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                          ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="15" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" Text="&#xE7BA;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding SourceLabel}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                       FontFamily="Consolas"
                                                       FontSize="8"
                                                       Text="{Binding SourceProvenanceLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceProvenanceLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <WrapPanel>
                <Border x:Name="DailySummaryRepeatedIssuesRegion" Width="420" Style="{StaticResource SectionCard}" automation:AutomationProperties.Name="{Binding [DailySummaryRepeatedIssuesTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryRepeatedIssuesTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding RepeatedIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3"
                                            Padding="9"
                                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource HerdrOps.Radius.Default}"
                                            Focusable="True"
                                            automation:AutomationProperties.Name="{Binding Description}"
                                            automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                            ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding SourceLabel}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                           FontFamily="Consolas"
                                                           FontSize="8"
                                                           Text="{Binding SourceProvenanceLabel}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SourceProvenanceLabel}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Chart.Idle}" FontSize="11" Text="{Binding OccurrenceLabel}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [DailySummarySourceLinks], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                </Border>

                <Border x:Name="DailySummaryRecommendationsRegion" Width="420" Style="{StaticResource SectionCard}" automation:AutomationProperties.Name="{Binding [DailySummaryRecommendationsTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryRecommendationsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding RecommendedActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5"
                                          Focusable="True"
                                          automation:AutomationProperties.Name="{Binding Description}"
                                          automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                          ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="21" Height="21" BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}" BorderThickness="1" CornerRadius="11">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding Number}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding SourceLabel}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                       FontFamily="Consolas"
                                                       FontSize="8"
                                                       Text="{Binding SourceProvenanceLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceProvenanceLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="DailySummaryTimelineRegion" Width="420" Style="{StaticResource SectionCard}" automation:AutomationProperties.Name="{Binding [DailySummaryTimelineTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryTimelineTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4"
                                          Focusable="True"
                                          automation:AutomationProperties.Name="{Binding Summary}"
                                          automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                          ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding Time}" />
                                        <Ellipse Grid.Column="1" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" />
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Category}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <ItemsControl Margin="0,2,0,0"
                                                          ItemsSource="{Binding SourceIds}"
                                                          AutomationProperties.Name="{Binding SourceLabel}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="9"
                                                                   Text="{Binding}"
                                                                   AutomationProperties.Name="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                       FontFamily="Consolas"
                                                       FontSize="8"
                                                       Text="{Binding SourceProvenanceLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceProvenanceLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <WrapPanel>
                <Border x:Name="DailySummaryWorkstreamRegion"
                        Width="860"
                        Style="{StaticResource SectionCard}"
                        Focusable="True"
                        automation:AutomationProperties.Name="{Binding [DailySummaryWorkstreamTitle], Source={x:Static localization:UiLanguageService.Shared}}"
                        automation:AutomationProperties.HelpText="{Binding SourceSetLabel}"
                        ToolTip="{Binding SourceSetLabel}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryWorkstreamTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Grid Margin="0,10,0,0" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,8,0" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnWorkstream], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnStatus], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnSources], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnActivityEvidence], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Margin="0,0,8,0" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnProgress], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Margin="0,0,8,0" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnScore], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Style="{StaticResource SmallCaption}" Text="{Binding [DailySummaryColumnImportant], Source={x:Static localization:UiLanguageService.Shared}}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Workstreams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0"
                                          Focusable="True"
                                          automation:AutomationProperties.Name="{Binding Workstream}"
                                          automation:AutomationProperties.HelpText="{Binding SourceProvenanceLabel}"
                                          ToolTip="{Binding SourceProvenanceLabel}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding Workstream}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Margin="0,0,8,0" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" Text="{Binding StatusLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLabel}" />
                                        <TextBlock Grid.Column="2" Margin="0,0,8,0" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" Text="{Binding SourceCountLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Margin="0,0,8,0" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" Text="{Binding ActivityEvidenceLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Margin="0,0,8,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" Text="{Binding ProgressLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Margin="0,0,8,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" Text="{Binding ScoreLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="6" Text="{Binding ImportantLabel}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="7"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                   FontFamily="Consolas"
                                                   FontSize="8"
                                                   Text="{Binding SourceProvenanceLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourceProvenanceLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="DailySummaryDayOverviewRegion"
                        Width="420"
                        Style="{StaticResource SectionCard}"
                        Focusable="True"
                        automation:AutomationProperties.Name="{Binding [DailySummaryDayOverviewTitle], Source={x:Static localization:UiLanguageService.Shared}}"
                        automation:AutomationProperties.HelpText="{Binding SourceSetLabel}"
                        ToolTip="{Binding SourceSetLabel}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding [DailySummaryDayOverviewTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="34" FontWeight="SemiBold" Text="{Binding DailyScoreLabel}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding DailyScoreDetail}" TextWrapping="Wrap" />
                        <Border Margin="0,18,0,0" Padding="10" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}" BorderBrush="{DynamicResource HerdrOps.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SmallCaption}" Text="{Binding [DailySummarySourceLinks], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding SourceSetLabel}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding ResultLabel}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
