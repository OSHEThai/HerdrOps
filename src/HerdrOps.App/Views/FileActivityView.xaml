<UserControl x:Class="HerdrOps.App.Views.FileActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />

        <Style x:Key="FileSummaryCard" BasedOn="{StaticResource HerdrOps.Style.Card}" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="14,11" />
        </Style>

        <Style x:Key="FileFilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="FileFilterCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0,30,0" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FileFilterComboItem}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <Grid>
                                    <TextBlock Margin="10,0,30,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,0,10,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="170"
                                        Margin="0,3,0,0"
                                        Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                    <ScrollViewer MaxHeight="280"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Primary}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileEventItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,8,7" />
        </Style>

        <Style x:Key="FileDetailValue" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="8,0,0,7" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="FileRoot" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SourceRow" Height="25" />
            <RowDefinition x:Name="SummaryRow" Height="104" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="FilterRow" Height="48" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="AnalyticsRow" Height="164" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Padding="8,2"
                    VerticalAlignment="Top"
                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                <TextBlock Tag="FileLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="10" FontWeight="SemiBold" Text="{Binding SourceLabel}" />
            </Border>
            <TextBlock Grid.Column="2" Tag="FileLanguageCheck" VerticalAlignment="Top" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding ConnectionLabel}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <ItemsControl x:Name="FileSummaryCardsRegion" Grid.Row="1" ItemsSource="{Binding SummaryCards}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource FileSummaryCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Tag="FileLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="12" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding Value}" />
                                <TextBlock Margin="0,1,0,0" Tag="FileLanguageCheck" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="9" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}" BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="17" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" Text="{Binding IconGlyph}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="FileFiltersRegion"
                Grid.Row="3"
                Padding="8,6"
                Style="{DynamicResource HerdrOps.Style.Card}"
                automation:AutomationProperties.Name="{Binding [FileFiltersAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="8" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                             Padding="31,7,10,7"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                             Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                             BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                             BorderThickness="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="{Binding [FileSearchPlaceholder], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" Text="&#xE721;" IsHitTestVisible="False" />
                    <TextBlock Margin="31,0,8,0" Tag="FileLanguageCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [FileSearchPlaceholder], Source={x:Static localization:UiLanguageService.Shared}}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Grid.Column="2" ItemsSource="{Binding ActionFilters}" SelectedItem="{Binding SelectedActionFilter, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource FileFilterCombo}" automation:AutomationProperties.Name="{Binding [FileColumnAction], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding TaskFilters}" SelectedItem="{Binding SelectedTaskFilter, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource FileFilterCombo}" automation:AutomationProperties.Name="{Binding [FileColumnTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Column="6" ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSourceFilter, Mode=TwoWay}" DisplayMemberPath="Label" Style="{StaticResource FileFilterCombo}" automation:AutomationProperties.Name="{Binding [FileColumnSource], Source={x:Static localization:UiLanguageService.Shared}}" />
                <Border Grid.Column="8" Padding="9,0" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}" BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                    <TextBlock Tag="FileLanguageCheck" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding [FileDateRange], Source={x:Static localization:UiLanguageService.Shared}}" />
                </Border>
                <Button Grid.Column="10" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [FileFilters], Source={x:Static localization:UiLanguageService.Shared}}">
                    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Text="&#xE71C;" /><TextBlock Margin="6,0,0,0" Tag="FileLanguageCheck" Text="{Binding [FileFilters], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3.05*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>

            <Border x:Name="FileEventTableRegion"
                    Grid.Column="0"
                    Style="{DynamicResource HerdrOps.Style.Card}"
                    automation:AutomationProperties.Name="{Binding [FileTableAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10,0" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                        <TextBlock Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnTime], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnAgent], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="2" Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnAction], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="3" Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnPath], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="4" Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="5" Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnConfidence], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="6" Tag="FileLanguageCheck" VerticalAlignment="Center" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [FileColumnSource], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                    <ListBox x:Name="FileEventList"
                             Grid.Row="1"
                             ItemsSource="{Binding VisibleEvents}"
                             SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FileEventItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="37" Margin="10,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="96" /><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="90" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="10" Text="{Binding Time}" />
                                    <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" HorizontalAlignment="Left" Background="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="SemiBold" Text="{Binding Initials}" /></Border>
                                        <TextBlock Grid.Column="1" Tag="FileLanguageCheck" VerticalAlignment="Center" FontSize="10" Text="{Binding Agent}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Margin="0,0,6,0" Tag="FileLanguageCheck" VerticalAlignment="Center" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="10" FontWeight="SemiBold" Text="{Binding Action}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontFamily="Consolas" FontSize="9" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="10" Text="{Binding TaskId}" />
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" Foreground="{Binding ScopeBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="10" FontWeight="SemiBold" Text="{Binding Confidence}" />
                                        <Border Height="3" Margin="6,2" Background="{DynamicResource HerdrOps.Brush.Border}" CornerRadius="2"><Border Width="44" HorizontalAlignment="Left" Background="{Binding ScopeBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="2" /></Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="6" Tag="FileLanguageCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="9" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.ColumnSpan="7" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource HerdrOps.Brush.Border}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="10,0"><TextBlock Tag="FileLanguageCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding ResultLabel}" /></Grid>
                </Grid>
            </Border>

            <Border x:Name="FileDetailsRegion" Grid.Column="2" Padding="12" Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="66" /><RowDefinition Height="126" /><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Tag="FileLanguageCheck" FontSize="13" FontWeight="SemiBold" Text="{Binding [FileDetails], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <Grid Grid.Row="1" DataContext="{Binding SelectedDetail}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}" CornerRadius="6"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" Text="&#xE8A5;" /></Border>
                        <StackPanel Grid.Column="1"><TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" FontFamily="Consolas" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="8" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <Border Grid.Column="2" Padding="7,3" VerticalAlignment="Top" Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}" CornerRadius="4"><TextBlock Tag="FileLanguageCheck" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="9" Text="{Binding Status}" /></Border>
                    </Grid>
                    <Grid Grid.Row="2" DataContext="{Binding SelectedDetail}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailSize], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailType], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailModified], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailActor], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailConfidence], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailLabel}" Text="{Binding [FileDetailSource], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource FileDetailValue}" Text="{Binding Size}" />
                            <TextBlock Style="{StaticResource FileDetailValue}" Text="{Binding FileType}" />
                            <TextBlock Style="{StaticResource FileDetailValue}" Text="{Binding ModifiedTime}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailValue}" Text="{Binding Actor}" />
                            <TextBlock Style="{StaticResource FileDetailValue}" Text="{Binding TaskId}" />
                            <TextBlock Style="{StaticResource FileDetailValue}" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" Text="{Binding Confidence}" />
                            <TextBlock Tag="FileLanguageCheck" Style="{StaticResource FileDetailValue}" Text="{Binding Source}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Tag="FileLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" FontWeight="SemiBold" Text="{Binding [FileDiffPreview], Source={x:Static localization:UiLanguageService.Shared}}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Row="4" Padding="8" Background="#07111D" BorderBrush="{DynamicResource HerdrOps.Brush.Border}" BorderThickness="1" CornerRadius="5">
                        <ItemsControl ItemsSource="{Binding SelectedDetail.DiffLines}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock FontFamily="Consolas" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="9" Text="{Binding}" TextTrimming="CharacterEllipsis" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
            <Border x:Name="FileTimelineRegion" Grid.Column="0" Padding="12" Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Tag="FileLanguageCheck" FontSize="12" FontWeight="SemiBold" Text="{Binding [FileActivityOverTime], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ActivityOverTime}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="18" /></Grid.RowDefinitions><Border Width="14" Height="{Binding Value}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{Binding BrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="3,3,0,0" /><TextBlock Grid.Row="1" HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="8" Text="{Binding Label}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Grid>
            </Border>
            <Border x:Name="FileTypeRegion" Grid.Column="2" Padding="12" Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Tag="FileLanguageCheck" FontSize="12" FontWeight="SemiBold" Text="{Binding [FileActivityByType], Source={x:Static localization:UiLanguageService.Shared}}" /><ItemsControl Grid.Row="1" ItemsSource="{Binding FileTypeActivity}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontFamily="Consolas" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="9" Text="{Binding Label}" /><Border Grid.Column="1" Height="8" VerticalAlignment="Center" Background="{DynamicResource HerdrOps.Brush.Border}" CornerRadius="4"><Border Width="{Binding Value}" HorizontalAlignment="Left" Background="{Binding BrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="4" /></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
            </Border>
            <Border x:Name="FileRiskRegion" Grid.Column="4" Padding="12" Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Tag="FileLanguageCheck" FontSize="12" FontWeight="SemiBold" Text="{Binding [FileRiskPaths], Source={x:Static localization:UiLanguageService.Shared}}" /><ItemsControl Grid.Row="1" ItemsSource="{Binding RiskPaths}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="31"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontFamily="Consolas" FontSize="9" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" /><TextBlock Tag="FileLanguageCheck" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="8" Text="{Binding Classification}" /></StackPanel><TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="9" Text="{Binding Count}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="9" FontWeight="SemiBold" Text="{Binding Trend}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
