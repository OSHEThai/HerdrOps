<!-- Hallmark · macrostructure: Dashboard/Control Panel · genre: operational atmospheric · palette: navy/blue with evidence-bound status accents · pre-emit critique: P5 H5 E4 S5 R5 V4 · slop: pass (WPF-applicable gates) -->
<UserControl x:Class="HerdrOps.App.Views.TaskAlignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             ClipToBounds="True"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />

        <DataTemplate x:Key="AlignmentPanelItemTemplate">
            <Border Padding="10,8"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,0,0,1"
                    ToolTip="{Binding Provenance}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22"
                            Height="22"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                            BorderBrush="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding Marker}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Tag="AlignmentLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <TextBlock Margin="0,2,0,0"
                                   Tag="AlignmentLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="9"
                                   Text="{Binding Detail}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               MaxWidth="110"
                               VerticalAlignment="Top"
                               Tag="AlignmentLanguageCheck"
                               Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Text="{Binding Status}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="AlignmentPanelTitle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="AlignmentLanguageCheck" />
        </Style>

        <Style x:Key="AlignmentScoreLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Tag" Value="AlignmentLanguageCheck" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="AlignmentRoot"
          Margin="14"
          automation:AutomationProperties.Name="{Binding [AlignmentPageAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SourceRow" Height="26" />
            <RowDefinition x:Name="VerdictRow" Height="58" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="HeaderRow" Height="116" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Padding="8,2"
                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                <TextBlock Tag="AlignmentLanguageCheck"
                           Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="{Binding ProjectLabel}" />
            </Border>
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Top"
                       Tag="AlignmentLanguageCheck"
                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                       FontSize="11"
                       Text="{Binding SourceLabel}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4"
                       MaxWidth="610"
                       VerticalAlignment="Top"
                       Tag="AlignmentLanguageCheck"
                       automation:AutomationProperties.Name="{Binding [AlignmentEvidenceBoundaryAutomation], Source={x:Static localization:UiLanguageService.Shared}}"
                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                       FontSize="10"
                       Text="{Binding EvidenceBoundary}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding EvidenceBoundary}" />
        </Grid>

        <Border x:Name="AlignmentVerdictRegion"
                Grid.Row="1"
                Padding="14,8"
                Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                BorderBrush="{Binding Header.VerdictBrushKey, Converter={StaticResource ResourceBrush}}"
                BorderThickness="1"
                CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28"
                        Height="28"
                        Background="{DynamicResource HerdrOps.Brush.Background}"
                        BorderBrush="{Binding Header.VerdictBrushKey, Converter={StaticResource ResourceBrush}}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                               Foreground="{Binding Header.VerdictBrushKey, Converter={StaticResource ResourceBrush}}"
                               FontSize="14"
                               Text="{Binding Header.VerdictGlyph}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Tag="AlignmentLanguageCheck"
                               Foreground="{Binding Header.VerdictBrushKey, Converter={StaticResource ResourceBrush}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="{Binding Header.Verdict}" />
                    <TextBlock Margin="0,2,0,0"
                               Tag="AlignmentLanguageCheck"
                               Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                               FontSize="10"
                               Text="{Binding Header.VerdictDetail}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           MaxWidth="520"
                           VerticalAlignment="Center"
                           Tag="AlignmentLanguageCheck"
                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                           FontSize="9"
                           Text="{Binding TraceLabel}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding TraceLabel}" />
            </Grid>
        </Border>

        <Border x:Name="AlignmentTaskHeaderRegion"
                Grid.Row="3"
                Padding="14,10"
                Style="{DynamicResource HerdrOps.Style.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="2.2*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46"
                            Height="46"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Primary}"
                            BorderThickness="1"
                            CornerRadius="23">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding Header.AssigneeInitials}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding Header.TaskId}" />
                        <TextBlock Margin="0,3,0,0"
                                   Tag="AlignmentLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Header.Goal}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Header.Goal}" />
                        <TextBlock Margin="0,3,0,0"
                                   Tag="AlignmentLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="9">
                            <Run Text="{Binding Header.AssigneeName}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Header.AssignmentTime}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource HerdrOps.Brush.Border}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AlignmentScoreLabel}"
                               Text="{Binding [AlignmentGoalScore], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding Header.GoalScore}" />
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource HerdrOps.Brush.Border}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AlignmentScoreLabel}"
                               Text="{Binding [AlignmentScopeScore], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HerdrOps.Brush.Chart.Idle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding Header.ScopeScore}" />
                </StackPanel>
                <Border Grid.Column="5" Background="{DynamicResource HerdrOps.Brush.Border}" />
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AlignmentScoreLabel}"
                               Text="{Binding [AlignmentAcceptanceScore], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HerdrOps.Brush.Chart.Working}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding Header.AcceptanceScore}" />
                </StackPanel>
                <Border Grid.Column="7" Background="{DynamicResource HerdrOps.Brush.Border}" />
                <StackPanel Grid.Column="8" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AlignmentScoreLabel}"
                               TextAlignment="Left"
                               Text="{Binding [AlignmentVerdictLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock Margin="0,4,0,0"
                               Tag="AlignmentLanguageCheck"
                               Foreground="{Binding Header.VerdictBrushKey, Converter={StaticResource ResourceBrush}}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="{Binding Header.Verdict}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="PanelGrid" Grid.Row="5" MinHeight="470">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AlignmentContractRegion" Grid.Row="0" Grid.Column="0" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentContractTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding ContractItems}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentAcknowledgementRegion" Grid.Row="0" Grid.Column="2" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentAcknowledgementTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding AcknowledgementItems}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentPlannedStepsRegion" Grid.Row="0" Grid.Column="4" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentPlannedStepsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding PlannedSteps}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentCriteriaRegion" Grid.Row="0" Grid.Column="6" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentCriteriaTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding AcceptanceCriteria}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentFilesRegion" Grid.Row="2" Grid.Column="0" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentFilesTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding FilesTouched}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentActionsRegion" Grid.Row="2" Grid.Column="2" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentActionsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding ObservedActions}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentDeviationRegion" Grid.Row="2" Grid.Column="4" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentDeviationTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding DeviationRequests}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="AlignmentEvidenceRegion" Grid.Row="2" Grid.Column="6" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Margin="12,0" Style="{StaticResource AlignmentPanelTitle}"
                                   Text="{Binding [AlignmentEvidenceTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemTemplate="{StaticResource AlignmentPanelItemTemplate}" ItemsSource="{Binding EvidenceItems}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
        </Grid>

        <Border Grid.Row="1"
                Grid.RowSpan="5"
                Margin="0"
                Padding="24"
                Background="{DynamicResource HerdrOps.Brush.Background}"
                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource HerdrOps.Radius.Default}"
                Panel.ZIndex="20">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAnalysis}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                           FontSize="34"
                           Foreground="{DynamicResource HerdrOps.Brush.BorderStrong}"
                           Text="{Binding Header.VerdictGlyph}" />
                <TextBlock Margin="0,14,0,0"
                           Tag="AlignmentLanguageCheck"
                           Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="{Binding [AlignmentEmptyTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                <TextBlock MaxWidth="680"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Tag="AlignmentLanguageCheck"
                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                           FontSize="12"
                           Text="{Binding EvidenceBoundary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
