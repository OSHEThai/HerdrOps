<UserControl x:Class="HerdrOps.App.Views.RealtimeActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />

        <Style x:Key="RealtimeSummaryCard"
               BasedOn="{StaticResource HerdrOps.Style.Card}"
               TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="RealtimeFilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RealtimeFilterCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0,30,0" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RealtimeFilterComboItem}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <Grid>
                                    <TextBlock Margin="10,0,30,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,0,10,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="170"
                                        Margin="0,3,0,0"
                                        Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.Primary}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RealtimeEventItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter TargetName="RowBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ActivityRoot" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SourceRow" Height="26" />
            <RowDefinition x:Name="SummaryRow" Height="104" />
            <RowDefinition Height="10" />
            <RowDefinition x:Name="FiltersRow" Height="68" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="8,2"
                    VerticalAlignment="Top"
                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                <TextBlock Tag="RealtimeLanguageCheck"
                           Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="{Binding SourceLabel}" />
            </Border>
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Top"
                       Tag="RealtimeLanguageCheck"
                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                       FontSize="11"
                       Text="{Binding ConnectionLabel}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <ItemsControl x:Name="SummaryCardsRegion"
                      Grid.Row="1"
                      ItemsSource="{Binding SummaryCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource RealtimeSummaryCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Tag="RealtimeLanguageCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                           FontSize="12"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Text="{Binding Value}" />
                                <TextBlock Margin="0,1,0,0"
                                           Tag="RealtimeLanguageCheck"
                                           Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                           FontSize="10"
                                           Text="{Binding Detail}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                           FontSize="17"
                                           Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                           Text="{Binding IconGlyph}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="FiltersRegion"
                Grid.Row="3"
                Padding="10,8"
                Style="{DynamicResource HerdrOps.Style.Card}"
                automation:AutomationProperties.Name="{Binding [RealtimeFilterAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeTimeRangeLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ComboBox x:Name="TimeFilter"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding TimeFilters}"
                              SelectedItem="{Binding SelectedTimeFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              automation:AutomationProperties.Name="{Binding [RealtimeTimeRangeLabel], Source={x:Static localization:UiLanguageService.Shared}}"
                              Style="{StaticResource RealtimeFilterCombo}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeRoleLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ComboBox x:Name="RoleFilter"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding RoleFilters}"
                              SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              automation:AutomationProperties.Name="{Binding [RealtimeRoleLabel], Source={x:Static localization:UiLanguageService.Shared}}"
                              Style="{StaticResource RealtimeFilterCombo}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeSeverityLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ComboBox x:Name="SeverityFilter"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding SeverityFilters}"
                              SelectedItem="{Binding SelectedSeverityFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              automation:AutomationProperties.Name="{Binding [RealtimeSeverityLabel], Source={x:Static localization:UiLanguageService.Shared}}"
                              Style="{StaticResource RealtimeFilterCombo}" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeTaskLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ComboBox x:Name="TaskFilter"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding TaskFilters}"
                              SelectedItem="{Binding SelectedTaskFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              automation:AutomationProperties.Name="{Binding [RealtimeTaskLabel], Source={x:Static localization:UiLanguageService.Shared}}"
                              Style="{StaticResource RealtimeFilterCombo}" />
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeEvidenceLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ComboBox x:Name="EvidenceFilter"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding EvidenceFilters}"
                              SelectedItem="{Binding SelectedEvidenceFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              automation:AutomationProperties.Name="{Binding [RealtimeEvidenceLabel], Source={x:Static localization:UiLanguageService.Shared}}"
                              Style="{StaticResource RealtimeFilterCombo}" />
                </StackPanel>
                <Border Grid.Column="10"
                        Padding="10,5"
                        Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                        BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                   Foreground="{DynamicResource HerdrOps.Brush.Status.Working}"
                                   Text="&#xE72C;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Tag="RealtimeLanguageCheck" FontSize="11" FontWeight="SemiBold" Text="{Binding [RealtimeAutoRefresh], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Tag="RealtimeLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding [RealtimeAutoRefreshOn], Source={x:Static localization:UiLanguageService.Shared}}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.35*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border x:Name="EventStreamRegion"
                    Grid.Column="0"
                    Padding="0"
                    Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Tag="RealtimeLanguageCheck"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding [RealtimeEventStream], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="10"
                                   Text="{Binding HistoryLabel}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Padding="12,0"
                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                            BorderThickness="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="154" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeTimeColumn], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeEventColumn], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeTaskColumn], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeActorColumn], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeSeverityColumn], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding VisibleEvents}"
                                 SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource RealtimeEventItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 automation:AutomationProperties.Name="{Binding [RealtimeEventListAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border MinHeight="59"
                                            Padding="10,6"
                                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="154" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="11" FontWeight="SemiBold" Text="{Binding Time}" />
                                                <TextBlock Tag="RealtimeLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding Elapsed}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Tag="RealtimeLanguageCheck" FontSize="11" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Tag="RealtimeLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="10" Text="{Binding TaskId}" TextTrimming="CharacterEllipsis" />
                                            <Grid Grid.Column="3" Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26"
                                                        Height="26"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                        CornerRadius="13">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="{Binding Initials}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Tag="RealtimeLanguageCheck" FontSize="10" Text="{Binding Actor}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Tag="RealtimeLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding Role}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Column="4"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                                    BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                                                <TextBlock Tag="RealtimeLanguageCheck" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="9" FontWeight="SemiBold" Text="{Binding Severity}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Tag="RealtimeLanguageCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   Text="{Binding [RealtimeNoEvents], Source={x:Static localization:UiLanguageService.Shared}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleEvents.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="3" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                MinHeight="30"
                                Padding="12,4"
                                IsEnabled="{Binding HasMore}"
                                Style="{DynamicResource HerdrOps.Style.SecondaryButton}"
                                Click="OnLoadMoreClick"
                                Content="{Binding [RealtimeLoadMore], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="0.85*" />
                </Grid.RowDefinitions>

                <Border x:Name="EventDetailsRegion"
                        Grid.Row="0"
                        Padding="12"
                        Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="38" />
                        </Grid.RowDefinitions>
                        <TextBlock Tag="RealtimeLanguageCheck" FontSize="14" FontWeight="SemiBold" Text="{Binding [RealtimeEventDetails], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,2,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            Background="{Binding SelectedDetail.AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                            CornerRadius="17">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="{Binding SelectedDetail.Initials}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Tag="RealtimeLanguageCheck" FontSize="12" FontWeight="SemiBold" Text="{Binding SelectedDetail.Title}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding SelectedDetail.EventId}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Padding="7,3"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                            BorderBrush="{Binding SelectedDetail.AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                                        <TextBlock Tag="RealtimeLanguageCheck" Foreground="{Binding SelectedDetail.AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="9" FontWeight="SemiBold" Text="{Binding SelectedDetail.Severity}" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailTime], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Grid.Column="1" FontSize="10" Text="{Binding SelectedDetail.Time}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="10" Text="{Binding SelectedDetail.TaskId}" />
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailActor], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Tag="RealtimeLanguageCheck" FontSize="10" Text="{Binding SelectedDetail.Actor}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Tag="RealtimeLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding SelectedDetail.Role}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,8,0,2" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailDescription], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <TextBlock Tag="RealtimeLanguageCheck" FontSize="10" Text="{Binding SelectedDetail.Description}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,2" Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailAction], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <TextBlock Tag="RealtimeLanguageCheck" FontSize="10" Text="{Binding SelectedDetail.Action}" TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailEvidence], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <TextBlock Margin="0,2,0,0" Tag="RealtimeLanguageCheck" FontSize="10" Text="{Binding SelectedDetail.EvidenceLevel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Tag="RealtimeLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [RealtimeDetailConfidence], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <TextBlock Margin="0,2,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="10" FontWeight="SemiBold" Text="{Binding SelectedDetail.Confidence}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2"
                                MinHeight="32"
                                IsEnabled="False"
                                Style="{DynamicResource HerdrOps.Style.SecondaryButton}"
                                Content="{Binding [RealtimeSendToCompliance], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border x:Name="EvidenceSourcesRegion"
                        Grid.Row="2"
                        Padding="12"
                        Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Tag="RealtimeLanguageCheck" FontSize="13" FontWeight="SemiBold" Text="{Binding [RealtimeEvidenceSources], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="10" Text="{Binding EvidenceSources.Count}" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EvidenceSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="25" Height="25" HorizontalAlignment="Left" Background="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="5">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="11" Text="&#xE8A5;" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Tag="RealtimeLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                        <TextBlock HorizontalAlignment="Right" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="9" FontWeight="SemiBold" Text="{Binding Confidence}" />
                                                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="8" Text="{Binding ObservedTime}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Tag="RealtimeLanguageCheck"
                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                       FontSize="10"
                                       Text="{Binding [RealtimeNoEvidence], Source={x:Static localization:UiLanguageService.Shared}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EvidenceSources.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
