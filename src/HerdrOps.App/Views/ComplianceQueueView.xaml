<UserControl x:Class="HerdrOps.App.Views.ComplianceQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             x:Name="ComplianceQueueRoot"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             automation:AutomationProperties.Name="{Binding [ComplianceQueuePageAutomation], Source={x:Static localization:UiLanguageService.Shared}}"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- The queue stays dense, but scroll affordances remain visible on dark surfaces. -->
        <Style x:Key="ComplianceScrollRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComplianceScrollThumb" TargetType="Thumb">
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Pill}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="8" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Orientation="{TemplateBinding Orientation}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ComplianceScrollRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ComplianceScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ComplianceScrollRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComplianceFilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComplianceFilterCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="9,0,28,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComplianceFilterComboItem}" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <Grid>
                                    <TextBlock Margin="9,0,28,0"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,0,9,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="150"
                                        Margin="0,3,0,0"
                                        Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComplianceIncidentItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComplianceEvidenceRow" TargetType="Border">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource HerdrOps.Radius.Default}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Availability}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="missing">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="Missing evidence">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AvailabilityState}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComplianceEvidenceAvailabilityBadge" TargetType="Border">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource HerdrOps.Radius.Pill}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Availability}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="missing">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Availability}" Value="Missing evidence">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AvailabilityState}" Value="Missing">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Review.MissingEvidence}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComplianceActionButton" TargetType="Button" BasedOn="{StaticResource HerdrOps.Style.SecondaryButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
                    <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
                    <Setter Property="Opacity" Value="0.94" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComplianceNavigationButton" TargetType="Button" BasedOn="{StaticResource HerdrOps.Style.SecondaryButton}">
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceRaised}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
                    <Setter Property="Opacity" Value="0.86" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComplianceDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,7,5" />
        </Style>

        <Style x:Key="ComplianceDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="7,0,0,5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ComplianceQueueMainColumn" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="104" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="58" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <ItemsControl x:Name="ComplianceSummaryCardsRegion"
                      Grid.Row="0"
                      ItemsSource="{Binding SummaryCards}"
                      automation:AutomationProperties.Name="{Binding [ComplianceQueuePageTitle], Source={x:Static localization:UiLanguageService.Shared}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,9,0"
                            Padding="12,10"
                            Style="{DynamicResource HerdrOps.Style.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Tag="ComplianceLanguageCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                            FontSize="12"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,2,0,0"
                                            FontSize="26"
                                           FontWeight="SemiBold"
                                           Text="{Binding Value}" />
                                <TextBlock Tag="ComplianceLanguageCheck"
                                           Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                            FontSize="10"
                                           Text="{Binding Detail}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                           FontSize="16"
                                           Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                           Text="{Binding IconGlyph}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="ComplianceFiltersRegion"
                Grid.Row="2"
                Padding="8,5"
                Style="{DynamicResource HerdrOps.Style.Card}"
                automation:AutomationProperties.Name="{Binding [ComplianceQueuePageTitle], Source={x:Static localization:UiLanguageService.Shared}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.45*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueFilterSeverity], Source={x:Static localization:UiLanguageService.Shared}}" />
                <TextBlock Grid.Column="2" Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueFilterState], Source={x:Static localization:UiLanguageService.Shared}}" />
                <TextBlock Grid.Column="4" Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueFilterActor], Source={x:Static localization:UiLanguageService.Shared}}" />
                <TextBlock Grid.Column="6" Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueFilterTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                <TextBlock Grid.Column="8" Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueFilterReviewer], Source={x:Static localization:UiLanguageService.Shared}}" />
                <TextBlock Grid.Column="10" Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueFilterSort], Source={x:Static localization:UiLanguageService.Shared}}" />

                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding SeverityFilters}"
                          SelectedItem="{Binding SelectedSeverityFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource ComplianceFilterCombo}"
                          automation:AutomationProperties.Name="{Binding [ComplianceQueueFilterSeverity], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Row="1"
                          Grid.Column="2"
                          ItemsSource="{Binding StateFilters}"
                          SelectedItem="{Binding SelectedStateFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource ComplianceFilterCombo}"
                          automation:AutomationProperties.Name="{Binding [ComplianceQueueFilterState], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Row="1"
                          Grid.Column="4"
                          ItemsSource="{Binding ActorFilters}"
                          SelectedItem="{Binding SelectedActorFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource ComplianceFilterCombo}"
                          automation:AutomationProperties.Name="{Binding [ComplianceQueueFilterActor], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Row="1"
                          Grid.Column="6"
                          ItemsSource="{Binding TaskFilters}"
                          SelectedItem="{Binding SelectedTaskFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource ComplianceFilterCombo}"
                          automation:AutomationProperties.Name="{Binding [ComplianceQueueFilterTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Row="1"
                          Grid.Column="8"
                          ItemsSource="{Binding ReviewerFilters}"
                          SelectedItem="{Binding SelectedReviewerFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource ComplianceFilterCombo}"
                          automation:AutomationProperties.Name="{Binding [ComplianceQueueFilterReviewer], Source={x:Static localization:UiLanguageService.Shared}}" />
                <ComboBox Grid.Row="1"
                          Grid.Column="10"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                          DisplayMemberPath="Label"
                          Style="{StaticResource ComplianceFilterCombo}"
                          automation:AutomationProperties.Name="{Binding [ComplianceQueueFilterSort], Source={x:Static localization:UiLanguageService.Shared}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">

            <Border x:Name="ComplianceIncidentTableRegion"
                    Grid.Column="0"
                    Padding="8"
                    Style="{DynamicResource HerdrOps.Style.Card}"
                    automation:AutomationProperties.Name="{Binding [ComplianceQueuePageTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ComplianceLanguageCheck"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding [ComplianceQueuePageTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1"
                                   Tag="ComplianceLanguageCheck"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                    FontSize="10"
                                   Text="{Binding SourceLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="4,0" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="1.12*" />
                            <ColumnDefinition Width="2.15*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Tag="ComplianceLanguageCheck" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueColumnSeverity], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" Tag="ComplianceLanguageCheck" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueColumnAgent], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="2" Tag="ComplianceLanguageCheck" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueColumnTaskIssue], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="3" Tag="ComplianceLanguageCheck" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueColumnState], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="4" Tag="ComplianceLanguageCheck" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueColumnTime], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="5" Tag="ComplianceLanguageCheck" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [ComplianceQueueColumnReviewer], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                    <ListBox x:Name="ComplianceIncidentList"
                             Grid.Row="2"
                             ItemsSource="{Binding VisibleIncidents}"
                             SelectedItem="{Binding SelectedIncident, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ComplianceIncidentItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyboardNavigation.DirectionalNavigation="Cycle"
                             automation:AutomationProperties.Name="{Binding [ComplianceQueuePageTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                             <Grid MinHeight="60" Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="1.12*" />
                                        <ColumnDefinition Width="2.15*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="1.25*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="58"
                                            Height="23"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="6,2"
                                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                            BorderBrush="{Binding SeverityBrushKey, Converter={StaticResource ResourceBrush}}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                        <TextBlock Tag="ComplianceLanguageCheck"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResourceBrush}}"
                                                    FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding SeverityLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                             <Grid Grid.Column="1" Margin="0,5,8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="25"
                                                Height="25"
                                                VerticalAlignment="Top"
                                                Background="{Binding SeverityBrushKey, Converter={StaticResource ResourceBrush}}"
                                                CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Background}" FontSize="8" FontWeight="SemiBold" Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                             <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}" Text="{Binding Actor}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                             <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding ReviewerRole}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="2" Margin="0,5,8,5">
                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontFamily="Consolas" FontSize="10" Text="{Binding TaskId}" />
                                         <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}" Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                         <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="3"
                                            MinWidth="58"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="5,2"
                                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                            BorderBrush="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                        <TextBlock Tag="ComplianceLanguageCheck"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}"
                                                   FontSize="10"
                                                   Text="{Binding StateLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="4" Margin="0,5,6,5">
                                         <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}" FontFamily="Consolas" FontSize="11" Text="{Binding Time}" />
                                         <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding RelativeTime}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Grid.Column="5" Margin="0,5,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="23" Height="23" VerticalAlignment="Top" Background="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Background}" FontSize="8" FontWeight="SemiBold" Text="{Binding ReviewerInitials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                             <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}" Text="{Binding Reviewer}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                             <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding ReviewerRole}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                     </ListBox>
                    <Border Grid.Row="3"
                            Margin="4,4,4,0"
                            Padding="4,3"
                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                            BorderThickness="0,1,0,0"
                            x:Name="ComplianceQueueFooter"
                            automation:AutomationProperties.Name="{Binding [ComplianceQueuePageTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                            Text="{Binding VisibleRangeLabel}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="5,0,0,0"
                                           Tag="ComplianceLanguageCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                           FontSize="10"
                                           Text="{Binding SourceLabel}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹"
                                        IsEnabled="False"
                                        Style="{StaticResource ComplianceNavigationButton}"
                                        Tag="ComplianceNavigationFirst"
                                         automation:AutomationProperties.Name="{Binding [ComplianceQueuePaginationPreviousName], Source={x:Static localization:UiLanguageService.Shared}}"
                                         automation:AutomationProperties.HelpText="{Binding [ComplianceQueuePaginationPreviousHelp], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <Button Content="1"
                                        IsEnabled="False"
                                        Style="{StaticResource ComplianceNavigationButton}"
                                        Tag="ComplianceNavigationCurrent"
                                         automation:AutomationProperties.Name="{Binding [ComplianceQueuePaginationCurrentName], Source={x:Static localization:UiLanguageService.Shared}}"
                                         automation:AutomationProperties.HelpText="{Binding [ComplianceQueuePaginationCurrentHelp], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <Button Content="›"
                                        IsEnabled="False"
                                        Style="{StaticResource ComplianceNavigationButton}"
                                        Tag="ComplianceNavigationNext"
                                         automation:AutomationProperties.Name="{Binding [ComplianceQueuePaginationNextName], Source={x:Static localization:UiLanguageService.Shared}}"
                                         automation:AutomationProperties.HelpText="{Binding [ComplianceQueuePaginationNextHelp], Source={x:Static localization:UiLanguageService.Shared}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            </Grid>
        </Grid>

            <Border x:Name="ComplianceQueueDetailColumn"
                    Grid.Column="2"
                    Padding="0"
                    Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="ComplianceDetailsEvidenceViewport"
                                  Grid.Row="0"
                                  Padding="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <Border x:Name="ComplianceDetailsRegion"
                                Padding="11"
                                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                BorderThickness="0,0,0,1"
                                automation:AutomationProperties.Name="{Binding [ComplianceQueueDetailsTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="24" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Tag="ComplianceLanguageCheck"
                                            FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="{Binding [ComplianceQueueDetailsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <TextBlock Grid.Row="1"
                                           Tag="ComplianceLanguageCheck"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                           FontSize="10"
                                           Text="{Binding [ComplianceQueueNoSelection], Source={x:Static localization:UiLanguageService.Shared}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Row="1" DataContext="{Binding SelectedDetail}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" Background="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Background}" FontSize="9" FontWeight="SemiBold" Text="{Binding Initials}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,4,0">
                                            <TextBlock Text="{Binding Actor}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding ActorRole}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="6,3" Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}" BorderBrush="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                                             <TextBlock Tag="ComplianceLanguageCheck" Foreground="{Binding StateBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="10" Text="{Binding StateLabel}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="57" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueIncidentLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <TextBlock Grid.Column="1" FontFamily="Consolas" Style="{StaticResource ComplianceDetailValue}" Text="{Binding IncidentId}" />
                                        <TextBlock Grid.Column="2" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueSeverityLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <TextBlock Grid.Column="3" Tag="ComplianceLanguageCheck" Foreground="{Binding SeverityBrushKey, Converter={StaticResource ResourceBrush}}" Style="{StaticResource ComplianceDetailValue}" Text="{Binding SeverityLabel}" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="57" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueTaskLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <StackPanel Grid.Column="1" Margin="7,0,0,5">
                                             <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" Text="{Binding TaskId}" />
                                             <TextBlock Tag="ComplianceLanguageCheck" FontSize="10" Text="{Binding TaskTitle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueReviewerLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <TextBlock Grid.Column="3" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailValue}" Text="{Binding Reviewer}" />
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueRuleLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <StackPanel Grid.Column="1" Margin="7,0,0,5">
                                             <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" Text="{Binding RuleId}" />
                                             <TextBlock Tag="ComplianceLanguageCheck" FontSize="10" Text="{Binding RuleLabel}" TextTrimming="CharacterEllipsis" />
                                             <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding RuleDescription}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Row="2" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueDescriptionLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                 <TextBlock Grid.Row="3" DataContext="{Binding SelectedDetail}" Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="4" DataContext="{Binding SelectedDetail}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueDetectedByLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Grid.Column="1" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailValue}" Text="{Binding DetectedBy}" />
                                    <TextBlock Grid.Column="2" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailLabel}" Text="{Binding [ComplianceQueueDetectedAtLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Grid.Column="3" Tag="ComplianceLanguageCheck" Style="{StaticResource ComplianceDetailValue}" Text="{Binding Timestamp}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="ComplianceEvidenceRegion"
                                MinHeight="245"
                                Padding="11"
                                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                BorderThickness="0,0,0,1"
                                automation:AutomationProperties.Name="{Binding [ComplianceQueueEvidenceTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                            <StackPanel>
                                 <TextBlock Tag="ComplianceLanguageCheck" FontSize="13" FontWeight="SemiBold" Text="{Binding [ComplianceQueueEvidenceTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                                 <ListBox Margin="0,6,0,0"
                                         ItemsSource="{Binding SelectedDetail.EvidenceItems}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         IsHitTestVisible="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ComplianceEvidenceRow}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                         <RowDefinition Height="23" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="22" Height="22" Background="{DynamicResource HerdrOps.Brush.Surface}" BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="12" Text="{Binding IconGlyph}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                                             <TextBlock Text="{Binding FileName}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                             <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding TypeLabel}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                         <TextBlock Grid.Column="2" Margin="4,0,7,0" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Timestamp}" />
                                                        <Border Grid.Column="3" Style="{StaticResource ComplianceEvidenceAvailabilityBadge}" VerticalAlignment="Center">
                                                             <TextBlock Tag="ComplianceLanguageCheck" Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="10" FontWeight="SemiBold" Text="{Binding AvailabilityLabel, FallbackValue=—, TargetNullValue=—}" TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>
                                                     <Grid Grid.Row="1" Margin="26,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.15*" />
                                                            <ColumnDefinition Width="1.15*" />
                                                            <ColumnDefinition Width="1.45*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                             <TextBlock Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" FontSize="10" Text="{Binding [FileDetailSource], Source={x:Static localization:UiLanguageService.Shared}}" />
                                                             <TextBlock FontSize="10" Text="{Binding Source, FallbackValue=—, TargetNullValue=—}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                             <TextBlock Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" FontSize="10" Text="{Binding [RealtimeEvidenceLabel], Source={x:Static localization:UiLanguageService.Shared}}" />
                                                             <TextBlock Tag="ComplianceLanguageCheck" FontSize="10" Text="{Binding AvailabilityLabel, FallbackValue=—, TargetNullValue=—}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="7,0,0,0">
                                                             <TextBlock Tag="ComplianceLanguageCheck" Style="{DynamicResource HerdrOps.Style.Text.Caption}" FontSize="10" Text="{Binding [DelegationLabelProvenance], Source={x:Static localization:UiLanguageService.Shared}}" />
                                                             <TextBlock FontFamily="Consolas" FontSize="10" Text="{Binding Sha256, FallbackValue=—, TargetNullValue=—}" TextTrimming="CharacterEllipsis" />
                                                             <TextBlock FontFamily="Consolas" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Reference, FallbackValue=—, TargetNullValue=—}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            x:Name="ComplianceActionsRegion"
                            Padding="10,7,10,6"
                            Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                            BorderThickness="0,1,0,0"
                            automation:AutomationProperties.Name="{Binding [ComplianceQueueReviewActionsTitle], Source={x:Static localization:UiLanguageService.Shared}}">
                            <StackPanel>
                                <TextBlock Tag="ComplianceLanguageCheck" FontSize="13" FontWeight="SemiBold" Text="{Binding [ComplianceQueueReviewActionsTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ReviewActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ComplianceActionButton}"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    ToolTip="{Binding UnavailableReason}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    automation:AutomationProperties.Name="{Binding Label}"
                                                    automation:AutomationProperties.HelpText="{Binding UnavailableReason}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="25" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Top"
                                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                                               Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                               FontSize="13"
                                                               Text="{Binding IconGlyph}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Tag="ComplianceLanguageCheck" FontSize="11" FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding RequiredRoleLabel}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Tag="ComplianceLanguageCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding UnavailableReason}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                </Grid>
            </Border>
    </Grid>
</UserControl>
