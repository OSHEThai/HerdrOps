<UserControl x:Class="HerdrOps.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:views="clr-namespace:HerdrOps.App.Views"
             MinWidth="640"
             MinHeight="480"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             FontFamily="{DynamicResource HerdrOps.FontFamily.UI}"
             PreviewKeyDown="OnPreviewKeyDown"
             SizeChanged="OnShellSizeChanged">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />
    </UserControl.Resources>
    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HerdrOps.Brush.TopBar}"
                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BrandColumn" Width="248" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="136" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="14,6">
                    <Rectangle x:Name="WideBrandMark"
                               Width="198"
                               Height="53"
                               HorizontalAlignment="Left"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/HerdrOps.App;component/Assets/Brand/ApprovedOverviewReference.png"
                                        Viewbox="12,5,210,56"
                                        ViewboxUnits="Absolute"
                                        Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="CompactBrandMark"
                               Width="48"
                               Height="48"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/HerdrOps.App;component/Assets/Brand/ApprovedOverviewReference.png"
                                        Viewbox="16,8,48,48"
                                        ViewboxUnits="Absolute"
                                        Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <Border Grid.Column="1"
                        Background="{DynamicResource HerdrOps.Brush.Border}" />

                <Button Grid.Column="2"
                        Style="{DynamicResource HerdrOps.Style.ChromeButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        automation:AutomationProperties.Name="{Binding [ToggleNavigation], Source={x:Static localization:UiLanguageService.Shared}}"
                        Click="OnToggleSidebarClick">
                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                               FontSize="18"
                               Text="&#xE700;" />
                </Button>

                <TextBlock Grid.Column="3"
                           Margin="0,0,18,0"
                           VerticalAlignment="Center"
                           Style="{DynamicResource HerdrOps.Style.Text.PageTitle}"
                           Text="{Binding SelectedDestination.DisplayName}" />

                <Border x:Name="ProjectSelector"
                        Grid.Column="4"
                        Width="310"
                        Height="42"
                        Margin="0,0,24,0"
                        Padding="13,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource HerdrOps.Brush.Sidebar}"
                        BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="14"
                                 Height="14"
                                 Stroke="{Binding LiveDashboard.ConnectionBrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ResourceBrush}}"
                                 StrokeThickness="2" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                   FontSize="14">
                            <Run Text="{Binding [ProjectPrefix], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" />
                            <Run Text=": " />
                            <Run Text="{Binding LiveDashboard.ProjectLabel, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </TextBlock>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   Text="&#xE70D;" />
                    </Grid>
                </Border>

                <StackPanel x:Name="StatusLegend"
                            Grid.Column="5"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            IsHitTestVisible="False">
                    <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource HerdrOps.Brush.Status.Working}" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding [StatusWorking], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource HerdrOps.Brush.Status.Idle}" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding [StatusIdle], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource HerdrOps.Brush.Status.Blocked}" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding [StatusBlocked], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource HerdrOps.Brush.Status.Review}" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding [StatusReview], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource HerdrOps.Brush.Status.Offline}" />
                        <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding [StatusOffline], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="LanguageSelector"
                        Grid.Column="6"
                        Width="88"
                        Height="36"
                        Margin="0,0,12,0"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource HerdrOps.Brush.Sidebar}"
                        BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ThaiLanguageButton"
                                Grid.Column="0"
                                automation:AutomationProperties.Name="{Binding [SelectThai], Source={x:Static localization:UiLanguageService.Shared}}"
                                ToolTip="{Binding [SelectThai], Source={x:Static localization:UiLanguageService.Shared}}"
                                Click="OnThaiLanguageClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HerdrOps.Style.ChromeButton}">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLanguage, Source={x:Static localization:UiLanguageService.Shared}}" Value="Thai">
                                            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="TH" />
                        </Button>
                        <Button x:Name="EnglishLanguageButton"
                                Grid.Column="1"
                                automation:AutomationProperties.Name="{Binding [SelectEnglish], Source={x:Static localization:UiLanguageService.Shared}}"
                                ToolTip="{Binding [SelectEnglish], Source={x:Static localization:UiLanguageService.Shared}}"
                                Click="OnEnglishLanguageClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HerdrOps.Style.ChromeButton}">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentLanguage, Source={x:Static localization:UiLanguageService.Shared}}" Value="English">
                                            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                            <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="EN" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{DynamicResource HerdrOps.Style.ChromeButton}"
                            automation:AutomationProperties.Name="{Binding [MinimizeWindow], Source={x:Static localization:UiLanguageService.Shared}}"
                            Click="OnMinimizeClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Text="&#xE921;" />
                    </Button>
                    <Button Style="{DynamicResource HerdrOps.Style.ChromeButton}"
                            automation:AutomationProperties.Name="{Binding [MaximizeWindow], Source={x:Static localization:UiLanguageService.Shared}}"
                            Click="OnMaximizeClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Text="&#xE922;" />
                    </Button>
                    <Button Style="{DynamicResource HerdrOps.Style.ChromeButton}"
                            automation:AutomationProperties.Name="{Binding [CloseWindow], Source={x:Static localization:UiLanguageService.Shared}}"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource HerdrOps.Brush.Sidebar}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="ProfileRow" Height="132" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavigationList"
                             Grid.Row="0"
                             Margin="0,12,0,8"
                             ItemsSource="{Binding Destinations}"
                             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                             ItemContainerStyle="{DynamicResource HerdrOps.Style.NavItem}"
                             Style="{DynamicResource HerdrOps.Style.SidebarList}"
                             automation:AutomationProperties.Name="{Binding [MainNavigation], Source={x:Static localization:UiLanguageService.Shared}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid automation:AutomationProperties.Name="{Binding DisplayName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NavigationIcon"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="18"
                                               Text="{Binding IconGlyph}" />
                                    <TextBlock x:Name="NavigationLabel"
                                               Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid.ToolTip>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid.ToolTip>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCompactSidebar, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter TargetName="NavigationLabel" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="ProfilePanel"
                            Grid.Row="1"
                            Padding="18,14"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{Binding LiveDashboard.AgentDetail.StatusBrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ResourceBrush}}"
                                    CornerRadius="21">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding LiveDashboard.AgentDetail.Initials, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border>
                            <StackPanel x:Name="ProfileText" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding LiveDashboard.AgentDetail.Name, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                           FontSize="12"
                                           Text="{Binding LiveDashboard.AgentDetail.Runtime, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{Binding LiveDashboard.AgentDetail.StatusBrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ResourceBrush}}" />
                                    <TextBlock Margin="6,0,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                               FontSize="12"
                                               Text="{Binding LiveDashboard.AgentDetail.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="ProfileChevron"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                       Text="&#xE70D;" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="PlaceholderPage" Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Tag="ThaiCheck"
                                   Style="{DynamicResource HerdrOps.Style.Text.PageTitle}"
                                   Text="{Binding SelectedDestination.DisplayName}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Primary}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="{Binding [SyntheticShellPreview], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44"
                                    Height="44"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                                    BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                           FontSize="21"
                                           Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                           Text="{Binding SelectedDestination.IconGlyph}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Tag="ThaiCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedDestination.DisplayName}" />
                                <TextBlock Margin="0,4,0,0"
                                           Tag="ThaiCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                           FontSize="14"
                                           Text="{Binding SelectedDestination.Summary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,16,0,0"
                                Background="{DynamicResource HerdrOps.Brush.Border}" />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="14"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [PlaceholderSource], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding [PlaceholderSyntheticOnly], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="12"
                                               Text="{Binding [PlaceholderNoRealAgents], Source={x:Static localization:UiLanguageService.Shared}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [PlaceholderRoute], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedDestination.Id}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="12"
                                               Text="{Binding [PlaceholderRegisteredRoute], Source={x:Static localization:UiLanguageService.Shared}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="14"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [PlaceholderConnection], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Offline}" />
                                        <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding [HerdrNotConnected], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="12"
                                               Text="{Binding [PlaceholderV02Connection], Source={x:Static localization:UiLanguageService.Shared}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="5"
                                Padding="20"
                                Background="{DynamicResource HerdrOps.Brush.Background}"
                                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="36"
                                               Foreground="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                               Text="{Binding SelectedDestination.IconGlyph}" />
                                    <TextBlock Margin="0,16,0,0"
                                               HorizontalAlignment="Center"
                                               Tag="ThaiCheck"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="{Binding [PlaceholderReady], Source={x:Static localization:UiLanguageService.Shared}}" />
                                    <TextBlock MaxWidth="640"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Tag="ThaiCheck"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="14"
                                               Text="{Binding [PlaceholderEvidenceBoundary], Source={x:Static localization:UiLanguageService.Shared}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           HorizontalAlignment="Center"
                                           Style="{DynamicResource HerdrOps.Style.Text.Caption}"
                                           Text="{Binding [PlaceholderKeyboard], Source={x:Static localization:UiLanguageService.Shared}}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <views:OverviewView x:Name="OverviewPage" Grid.Column="1" />
            <views:LiveOrganizationView x:Name="LiveOrganizationPage"
                                        Grid.Column="1"
                                        Visibility="Collapsed" />
            <views:AgentDetailView x:Name="AgentDetailPage"
                                   Grid.Column="1"
                                   Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource HerdrOps.Brush.TopBar}"
                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding LiveDashboard.ConnectionBrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ResourceBrush}}" />
                    <TextBlock Margin="8,0,0,0"
                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="12"
                               Text="{Binding LiveDashboard.StatusSummary, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="1"
                        Height="20"
                        Background="{DynamicResource HerdrOps.Brush.Border}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                           FontSize="12"
                           Text="{Binding LiveDashboard.LastUpdateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding LiveDashboard.ConnectionBrushKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ResourceBrush}}" />
                    <TextBlock Margin="8,0,18,0"
                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="12"
                               Text="{Binding LiveDashboard.ConnectionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="12"
                               Text="{Binding LiveDashboard.LatencyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
