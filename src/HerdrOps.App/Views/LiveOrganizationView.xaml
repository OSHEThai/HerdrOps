<UserControl x:Class="HerdrOps.App.Views.LiveOrganizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             ClipToBounds="True"
             SizeChanged="OnViewSizeChanged">
    <UserControl.Resources>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />
        <Style x:Key="OrganizationNodeItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NodeBorder"
                                Padding="8,6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NodeBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NodeBorder"
                                        Property="Background"
                                        Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                                <Setter TargetName="NodeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NodeBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="OrganizationRoot" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SourceRow" Height="28" />
            <RowDefinition x:Name="SummaryRow" Height="118" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition x:Name="AttentionRow" Height="108" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                       FontSize="11"
                       Text="{Binding ConnectionLabel}" />
            <Border Padding="9,3"
                    Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Primary}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="{Binding SourceLabel}" />
            </Border>
        </StackPanel>

        <ItemsControl x:Name="OrganizationSummaryRegion"
                      Grid.Row="1"
                      ItemsSource="{Binding SummaryCards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,12,0"
                            Padding="13,10"
                            Style="{DynamicResource HerdrOps.Style.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Tag="ThaiLiveOrganizationCheck"
                                           Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           Text="{Binding Value}" />
                                <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                           FontSize="10"
                                           Text="{Binding Detail}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                       FontSize="22"
                                       Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                       Text="{Binding IconGlyph}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="OrganizationHierarchyRegion"
                    Grid.Column="0"
                    Padding="0"
                    Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Tag="ThaiLiveOrganizationCheck"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding [OrganizationHierarchyTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                       FontSize="11"
                                       Text="{Binding [OrganizationHierarchySubtitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="10"
                                   Text="{Binding HierarchyLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             Margin="10,0,10,10"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource OrganizationNodeItem}"
                             ItemsSource="{Binding Nodes}"
                             SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                             SelectionChanged="OnNodeSelectionChanged"
                             automation:AutomationProperties.Name="{Binding [OrganizationHierarchyAutomation], Source={x:Static localization:UiLanguageService.Shared}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="{Binding IndentWidth}" />
                                    <Border Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Background="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                            CornerRadius="14">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Initials}" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="7,0,8,0">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                   FontSize="10"
                                                   Text="{Binding Subtitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                                   FontSize="10"
                                                   Text="{Binding Status}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border x:Name="OrganizationDetailRegion"
                    Grid.Column="2"
                    Padding="16"
                    Style="{DynamicResource HerdrOps.Style.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46"
                                Height="46"
                                Background="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                CornerRadius="23">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedAgent.Initials}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedAgent.Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                       FontSize="11"
                                       Text="{Binding SelectedAgent.Runtime}" />
                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                <TextBlock Margin="5,0,0,0"
                                           Foreground="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                           FontSize="10"
                                           Text="{Binding SelectedAgent.Status}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="2"
                                Padding="7,3"
                                VerticalAlignment="Top"
                                Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       FontSize="9"
                                       Text="{Binding [OrganizationAgentBadge], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Background="{DynamicResource HerdrOps.Brush.Border}" />
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [OrganizationLabelWorkspace], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedAgent.Workspace}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [OrganizationLabelTab], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAgent.Tab}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [OrganizationLabelPane], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAgent.Pane}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [OrganizationLabelTerminal], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAgent.Terminal}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="4" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [OrganizationLabelRevision], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAgent.Revision}" />
                        <TextBlock Grid.Row="5" Style="{DynamicResource HerdrOps.Style.Text.Caption}" Text="{Binding [OrganizationLabelDirectory], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Text="{Binding SelectedAgent.CurrentDirectory}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedAgent.CurrentDirectory}" />
                        <Border Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Margin="0,14,0,0"
                                Padding="10"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                       FontSize="10"
                                       Text="{Binding SelectedAgent.SourceNote}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="OrganizationAttentionRegion"
                Grid.Row="5"
                Padding="14,10"
                Style="{DynamicResource HerdrOps.Style.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Tag="ThaiLiveOrganizationCheck"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding [OrganizationAttentionTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                               FontSize="10"
                               Text="{Binding [OrganizationAttentionSubtitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding AttentionItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,0,0,0"
                                    Padding="10,7"
                                    Background="{DynamicResource HerdrOps.Brush.SurfaceRaised}"
                                    BorderBrush="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="17"
                                               Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceBrush}}"
                                               Text="{Binding IconGlyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                   FontSize="9"
                                                   Text="{Binding Detail}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
