<UserControl x:Class="HerdrOps.App.Widgets.WidgetSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             Background="Transparent"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             FontFamily="{DynamicResource HerdrOps.FontFamily.UI}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />

        <Style x:Key="WidgetHeaderButton"
               TargetType="Button"
               BasedOn="{StaticResource HerdrOps.Style.ChromeButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="WidgetMetricCard" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource HerdrOps.Radius.Large}" />
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1"
                                                        Background="{DynamicResource HerdrOps.Brush.BorderStrong}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AgentRowTemplate">
            <Grid Height="45" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Border Width="26"
                        Height="26"
                        HorizontalAlignment="Left"
                        Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                        CornerRadius="13">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="{Binding Initials}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="10"
                               Text="{Binding Activity}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                           FontSize="11"
                           Text="{Binding Elapsed}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource HerdrOps.Brush.Surface}"
            BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource HerdrOps.Radius.Large}"
            ClipToBounds="True">
        <Grid x:Name="SurfaceRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <Border x:Name="DragSurface"
                    Grid.Row="0"
                    Background="{DynamicResource HerdrOps.Brush.TopBar}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock x:Name="HeaderWordmark"
                                   Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Text="HERDROPS" />
                        <Ellipse x:Name="HeaderStatusDot"
                                 Width="7"
                                 Height="7"
                                 Margin="9,0,5,0"
                                 Fill="{Binding ConnectionBrushKey, Converter={StaticResource ResourceBrush}}" />
                        <TextBlock x:Name="HeaderSourceText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Text="{Binding SourceLabel}" />
                    </StackPanel>
                    <Button x:Name="PinButton"
                            Grid.Column="1"
                            Style="{StaticResource WidgetHeaderButton}"
                            Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}"
                            automation:AutomationProperties.Name="{Binding [WidgetPin], Source={x:Static localization:UiLanguageService.Shared}}"
                            Click="OnPinClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                   Text="&#xE840;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Grid.Column="2"
                            Style="{StaticResource WidgetHeaderButton}"
                            Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}"
                            automation:AutomationProperties.Name="{Binding [WidgetClose], Source={x:Static localization:UiLanguageService.Shared}}"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                   Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="WidgetBody" Grid.Row="1" Margin="10">
                <Grid x:Name="CompactPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource WidgetMetricCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="21" FontWeight="SemiBold" Text="{Binding WorkingCountLabel}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding [StatusWorking], Source={x:Static localization:UiLanguageService.Shared}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WidgetMetricCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontSize="21" FontWeight="SemiBold" Text="{Binding BlockedCountLabel}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding [StatusBlocked], Source={x:Static localization:UiLanguageService.Shared}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WidgetMetricCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Done}" FontSize="21" FontWeight="SemiBold" Text="{Binding DoneCountLabel}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding [StatusDone], Source={x:Static localization:UiLanguageService.Shared}}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PriorityNotices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="54" Margin="3,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="15"
                                               Text="{Binding IconGlyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Tag="ThaiWidgetCheck" FontSize="11" FontWeight="SemiBold" Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="3,4,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetScoreToday], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="11" FontWeight="SemiBold" Text="{Binding PositiveDeltaLabel}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontSize="11" FontWeight="SemiBold" Text="{Binding NegativeDeltaLabel}" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="18" FontWeight="SemiBold" Text="{Binding DailyScoreLabel}" />
                    </Grid>
                </Grid>

                <Grid x:Name="NormalPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Agents}" ItemTemplate="{StaticResource AgentRowTemplate}" />
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="2,5,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetOverallScore], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontWeight="SemiBold" Text="{Binding PositiveDeltaLabel}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontWeight="SemiBold" Text="{Binding NegativeDeltaLabel}" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontWeight="SemiBold" Text="{Binding DailyScoreLabel}" />
                    </Grid>
                </Grid>

                <Grid x:Name="ExpandedPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <Grid Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetAgent], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetRole], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetActivity], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="3" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetTime], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="4" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetScore], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Agents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,7,0" Fill="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Role}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Activity}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Elapsed}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="11" FontWeight="SemiBold" Text="{Binding ScoreLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="6,3,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding DetailsSourceLabel}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="11" FontWeight="SemiBold" Text="{Binding PositiveDeltaLabel}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontSize="11" FontWeight="SemiBold" Text="{Binding NegativeDeltaLabel}" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="15" FontWeight="SemiBold" Text="{Binding DailyScoreLabel}" />
                    </Grid>
                </Grid>

                <Grid x:Name="FloatingMiniPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="30" FontWeight="SemiBold" Text="{Binding WorkingCountLabel}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{Binding [StatusWorking], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontSize="30" FontWeight="SemiBold" Text="{Binding BlockedCountLabel}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{Binding [StatusBlocked], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Done}" FontSize="30" FontWeight="SemiBold" Text="{Binding DoneCountLabel}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{Binding [StatusDone], Source={x:Static localization:UiLanguageService.Shared}}" />
                        </StackPanel>
                    </UniformGrid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" FontSize="11" Text="{Binding [WidgetScoreToday], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="17" FontWeight="SemiBold" Text="{Binding DailyScoreLabel}" />
                    </Grid>
                </Grid>

                <Grid x:Name="FloatingVerticalPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  automation:AutomationProperties.Name="{Binding [WidgetAllAgentsList], Source={x:Static localization:UiLanguageService.Shared}}">
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="43">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="25" Height="25" Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="13">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}" FontSize="9" FontWeight="SemiBold" Text="{Binding Initials}" />
                                        </Border>
                                        <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Elapsed}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="15" FontWeight="SemiBold" Text="{Binding DailyScoreLabel}" />
                </Grid>

                <Grid x:Name="NotificationPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="67" Margin="3,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="16">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="13" Text="{Binding IconGlyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding Time}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Row="1" MinHeight="40" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [OverviewAlerts], Source={x:Static localization:UiLanguageService.Shared}}" Content="{Binding [WidgetViewAll], Source={x:Static localization:UiLanguageService.Shared}}" />
                </Grid>

                <Grid x:Name="AgentDetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="152" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,7,0" Fill="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding SelectedAgent.Name}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetRole], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetStatus], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="2" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetTask], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="3" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetStarted], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="4" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetScoreToday], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Row="5" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetAssignedBy], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Grid.Column="1" FontSize="11" Text="{Binding SelectedAgent.Role}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="11" Text="{Binding SelectedAgent.Status}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Text="{Binding SelectedAgent.Activity}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Text="{Binding SelectedAgent.StartedLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="11" Text="{Binding SelectedAgent.ScoreWithMaximumLabel}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" FontSize="11" Text="{Binding SelectedAgent.AssignedBy}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,5" FontSize="11" FontWeight="SemiBold" Text="{Binding [WidgetLatestActivity], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding SelectedAgentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Time}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Row="4"
                            MinHeight="40"
                            Style="{DynamicResource HerdrOps.Style.SecondaryButton}"
                            automation:AutomationProperties.Name="{Binding [WidgetViewAgentDetails], Source={x:Static localization:UiLanguageService.Shared}}"
                            Content="{Binding [WidgetViewAllDetails], Source={x:Static localization:UiLanguageService.Shared}}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterConnectionText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                           FontSize="9"
                           Text="{Binding ConnectionLabel}" />
                <Button Grid.Column="1"
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                        Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}"
                        automation:AutomationProperties.Name="{Binding [WidgetResetPosition], Source={x:Static localization:UiLanguageService.Shared}}"
                        Click="OnResetPositionClick">
                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="10" Text="&#xE777;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
