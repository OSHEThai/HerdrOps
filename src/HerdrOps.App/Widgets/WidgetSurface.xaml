<UserControl x:Class="HerdrOps.App.Widgets.WidgetSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:HerdrOps.App.Converters"
             Background="Transparent"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             FontFamily="{DynamicResource HerdrOps.FontFamily.UI}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <converters:ResourceKeyToBrushConverter x:Key="ResourceBrush" />

        <Style x:Key="WidgetHeaderButton"
               TargetType="Button"
               BasedOn="{StaticResource HerdrOps.Style.ChromeButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="WidgetMetricCard" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource HerdrOps.Radius.Large}" />
        </Style>

        <DataTemplate x:Key="AgentRowTemplate">
            <Grid Height="45" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Border Width="26"
                        Height="26"
                        HorizontalAlignment="Left"
                        Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                        CornerRadius="13">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="{Binding Initials}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="10"
                               Text="{Binding Activity}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                           FontSize="11"
                           Text="{Binding Elapsed}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource HerdrOps.Brush.Surface}"
            BorderBrush="{DynamicResource HerdrOps.Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource HerdrOps.Radius.Large}"
            ClipToBounds="True">
        <Grid x:Name="SurfaceRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <Border x:Name="DragSurface"
                    Grid.Row="0"
                    Background="{DynamicResource HerdrOps.Brush.TopBar}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnDragSurfaceMouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Text="HERDROPS" />
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="9,0,5,0"
                                 Fill="{DynamicResource HerdrOps.Brush.Status.Working}" />
                        <TextBlock x:Name="HeaderSourceText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Text="SYNTHETIC" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource WidgetHeaderButton}"
                            Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}"
                            automation:AutomationProperties.Name="ปักหมุดหรือยกเลิก Always on top"
                            Click="OnPinClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                   Text="&#xE840;" />
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource WidgetHeaderButton}"
                            Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}"
                            automation:AutomationProperties.Name="ปิด Widget"
                            Click="OnCloseClick">
                        <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                   Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="WidgetBody" Grid.Row="1" Margin="10">
                <Grid x:Name="CompactPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource WidgetMetricCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="21" FontWeight="SemiBold" Text="{Binding WorkingCount}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="Working" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WidgetMetricCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontSize="21" FontWeight="SemiBold" Text="{Binding BlockedCount}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="Blocked" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WidgetMetricCard}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Done}" FontSize="21" FontWeight="SemiBold" Text="{Binding DoneCount}" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="Done" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PriorityNotices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="54" Margin="3,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}"
                                               FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                               FontSize="15"
                                               Text="&#xE7BA;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Tag="ThaiWidgetCheck" FontSize="11" FontWeight="SemiBold" Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="3,4,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="คะแนนวันนี้" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="18" FontWeight="SemiBold" Text="{Binding DailyScore, StringFormat={}{0}/100}" />
                    </Grid>
                </Grid>

                <Grid x:Name="NormalPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Agents}" ItemTemplate="{StaticResource AgentRowTemplate}" />
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="2,5,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="คะแนนรวมวันนี้" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontWeight="SemiBold" Text="{Binding PositiveDelta, StringFormat=+{0}}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontWeight="SemiBold" Text="{Binding DailyScore, StringFormat={}{0}/100}" />
                    </Grid>
                </Grid>

                <Grid x:Name="ExpandedPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <Grid Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="Agent" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="Role" />
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="Task / Activity" />
                        <TextBlock Grid.Column="3" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="Time" />
                        <TextBlock Grid.Column="4" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="Score" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Agents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,7,0" Fill="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Role}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Activity}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Elapsed}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="11" FontWeight="SemiBold" Text="{Binding Score}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="6,3,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="รายละเอียดเดียวกันจากสถานะ Synthetic ชุดกลาง" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="15" FontWeight="SemiBold" Text="{Binding DailyScore, StringFormat={}{0}/100}" />
                    </Grid>
                </Grid>

                <Grid x:Name="FloatingMiniPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Working}" FontSize="30" FontWeight="SemiBold" Text="{Binding WorkingCount}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="Working" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Blocked}" FontSize="30" FontWeight="SemiBold" Text="{Binding BlockedCount}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="Blocked" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.Status.Done}" FontSize="30" FontWeight="SemiBold" Text="{Binding DoneCount}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="Done" />
                        </StackPanel>
                    </UniformGrid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" VerticalAlignment="Center" FontSize="11" Text="คะแนนวันนี้" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="17" FontWeight="SemiBold" Text="{Binding DailyScore, StringFormat={}{0}/100}" />
                    </Grid>
                </Grid>

                <Grid x:Name="FloatingVerticalPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding Agents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="43">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="25" Height="25" Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="13">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="{Binding Initials}" />
                                    </Border>
                                    <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Elapsed}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="15" FontWeight="SemiBold" Text="{Binding DailyScore, StringFormat={}{0}/100}" />
                </Grid>

                <Grid x:Name="NotificationPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="67" Margin="3,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="{Binding StatusBrushKey, Converter={StaticResource ResourceBrush}}" CornerRadius="16">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="13" Text="&#xE7BA;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="9" Text="{Binding Time}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Row="1" MinHeight="40" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="ดูการแจ้งเตือน Synthetic ทั้งหมด" Content="ดูทั้งหมด" />
                </Grid>

                <Grid x:Name="AgentDetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="142" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,7,0" Fill="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding SelectedAgent.Name}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="บทบาท" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="สถานะ" />
                        <TextBlock Grid.Row="2" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="งานปัจจุบัน" />
                        <TextBlock Grid.Row="3" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="เริ่มเมื่อ" />
                        <TextBlock Grid.Row="4" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="คะแนนวันนี้" />
                        <TextBlock Grid.Column="1" FontSize="11" Text="{Binding SelectedAgent.Role}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{Binding SelectedAgent.StatusBrushKey, Converter={StaticResource ResourceBrush}}" FontSize="11" Text="{Binding SelectedAgent.Status}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Text="{Binding SelectedAgent.Activity}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Text="14:20 (1h 27m)" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="11" Text="{Binding SelectedAgent.Score, StringFormat={}{0}/100}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,5" FontSize="11" FontWeight="SemiBold" Text="กิจกรรมล่าสุด" />
                    <ItemsControl Grid.Row="3" ItemsSource="{Binding SelectedAgentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="29">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding Time}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}" FontSize="10" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                           FontSize="9"
                           Text="{Binding ConnectionLabel}" />
                <Button Grid.Column="1"
                        Width="26"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                        Visibility="{Binding IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}"
                        automation:AutomationProperties.Name="คืน Widget ไปยังตำแหน่งที่มองเห็นได้"
                        Click="OnResetPositionClick">
                    <TextBlock FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}" FontSize="10" Text="&#xE777;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
