<UserControl x:Class="HerdrOps.App.Widgets.WidgetGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:localization="clr-namespace:HerdrOps.App.Localization"
             xmlns:widgets="clr-namespace:HerdrOps.App.Widgets"
             Background="{DynamicResource HerdrOps.Brush.Background}"
             Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
             FontFamily="{DynamicResource HerdrOps.FontFamily.UI}"
             SizeChanged="OnGallerySizeChanged">
    <Grid Background="{DynamicResource HerdrOps.Brush.Background}">
        <Grid x:Name="FullGallery" Background="{DynamicResource HerdrOps.Brush.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="438" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HerdrOps.Brush.TopBar}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="{Binding [WidgetGalleryTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Tag="ThaiWidgetCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                   FontSize="13"
                                   Text="{Binding SharedState.GalleryDescription, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Margin="0,0,16,0" Padding="10,4" Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}" BorderBrush="{DynamicResource HerdrOps.Brush.Primary}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                            <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding SharedState.SourceLabel, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                        </Border>
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Working}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" Text="{Binding [StatusWorking], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Idle}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" Text="{Binding [StatusIdle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Blocked}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" Text="{Binding [StatusBlocked], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Review}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" Text="{Binding [StatusReview], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Done}" />
                        <TextBlock Margin="6,0,14,0" FontSize="11" Text="{Binding [StatusDone], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource HerdrOps.Brush.Status.Offline}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" Text="{Binding [StatusOffline], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="282" />
                    <ColumnDefinition Width="312" />
                    <ColumnDefinition Width="480" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="214" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="1. " /><Run Text="{Binding [WidgetCompactName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetCompactDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="CompactPreview" Width="300" Height="330" IsInteractive="False" Variant="Compact" /></Viewbox>
                        <Button x:Name="OpenCompactButton" Grid.Row="2" Tag="Compact" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetCompactName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="2. " /><Run Text="{Binding [WidgetNormalName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetNormalDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="NormalPreview" Width="340" Height="448" IsInteractive="False" Variant="Normal" /></Viewbox>
                        <Button x:Name="OpenNormalButton" Grid.Row="2" Tag="Normal" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetNormalName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="3. " /><Run Text="{Binding [WidgetExpandedName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetExpandedDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="ExpandedPreview" Width="620" Height="390" IsInteractive="False" Variant="Expanded" /></Viewbox>
                        <Button x:Name="OpenExpandedButton" Grid.Row="2" Tag="Expanded" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetExpandedName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="4. " /><Run Text="{Binding [WidgetMiniName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetMiniDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="MiniPreview" Width="230" Height="220" IsInteractive="False" Variant="FloatingMini" /></Viewbox>
                        <Button x:Name="OpenMiniButton" Grid.Row="2" Tag="FloatingMini" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetMiniName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="4" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="5. " /><Run Text="{Binding [WidgetVerticalName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetVerticalDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="VerticalPreview" Width="168" Height="474" IsInteractive="False" Variant="FloatingVertical" /></Viewbox>
                        <Button x:Name="OpenVerticalButton" Grid.Row="2" Tag="FloatingVertical" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetVerticalName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="14,6,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312" />
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="6. " /><Run Text="{Binding [WidgetNotificationName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetNotificationDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="NotificationPreview" Width="328" Height="410" IsInteractive="False" Variant="Notification" /></Viewbox>
                        <Button x:Name="OpenNotificationButton" Grid.Row="2" Tag="Notification" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetNotificationName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="7. " /><Run Text="{Binding [WidgetAgentDetailName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetAgentDetailDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        <Viewbox Grid.Row="1" Stretch="Uniform"><widgets:WidgetSurface x:Name="AgentDetailPreview" Width="340" Height="448" IsInteractive="False" Variant="AgentDetailPopup" /></Viewbox>
                        <Button x:Name="OpenAgentDetailButton" Grid.Row="2" Tag="AgentDetailPopup" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetAgentDetailName], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenWidgetClick" Content="{Binding [WidgetOpen], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Margin="5" Style="{DynamicResource HerdrOps.Style.Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel><TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}" FontSize="14" FontWeight="SemiBold"><Run Text="8. " /><Run Text="{Binding [WidgetDashboardName], Mode=OneWay, Source={x:Static localization:UiLanguageService.Shared}}" /></TextBlock><TextBlock Tag="ThaiWidgetCheck" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="10" Text="{Binding [WidgetDashboardDescription], Source={x:Static localization:UiLanguageService.Shared}}" /></StackPanel>
                        </StackPanel>
                        <Border Grid.Row="1" Background="{DynamicResource HerdrOps.Brush.Background}" BorderBrush="{DynamicResource HerdrOps.Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource HerdrOps.Radius.Default}" ClipToBounds="True">
                            <Viewbox Stretch="Uniform"><ContentControl x:Name="DashboardPreviewHost" Width="1672" Height="941" IsHitTestVisible="False" /></Viewbox>
                        </Border>
                        <Button x:Name="OpenDashboardButton" Grid.Row="2" Tag="Dashboard" Style="{DynamicResource HerdrOps.Style.SecondaryButton}" automation:AutomationProperties.Name="{Binding [WidgetBackDashboardAutomation], Source={x:Static localization:UiLanguageService.Shared}}" Click="OnOpenDashboardClick" Content="{Binding [WidgetBackDashboard], Source={x:Static localization:UiLanguageService.Shared}}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource HerdrOps.Brush.TopBar}" BorderBrush="{DynamicResource HerdrOps.Brush.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource HerdrOps.Brush.TextMuted}" FontSize="11" Text="{Binding [WidgetKeyboardHelp], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="11"
                               Text="{Binding SharedState.ConnectionLabel, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AdaptiveGallery"
              Background="{DynamicResource HerdrOps.Brush.Background}"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource HerdrOps.Brush.TopBar}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding [WidgetGalleryTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                        <TextBlock Tag="ThaiWidgetCheck"
                                   Foreground="{DynamicResource HerdrOps.Brush.TextSecondary}"
                                   FontSize="11"
                                   Text="{Binding SharedState.GalleryDescription, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource HerdrOps.Brush.PrimarySubtle}"
                            BorderBrush="{DynamicResource HerdrOps.Brush.Primary}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource HerdrOps.Radius.Pill}">
                        <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Text="{Binding SharedState.SourceLabel, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                    </Border>
                </Grid>
            </Border>

            <ItemsControl x:Name="AdaptiveGalleryItems"
                          Grid.Row="1"
                          Margin="8"
                          ItemsSource="{Binding AdaptiveItems, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5"
                                Padding="9"
                                Style="{DynamicResource HerdrOps.Style.Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="39" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Tag="ThaiWidgetCheck"
                                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                               FontSize="9"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Viewbox x:Name="AdaptiveWidgetPreview"
                                         Grid.Row="1"
                                         Margin="0,2"
                                         Stretch="Uniform">
                                    <widgets:WidgetSurface Width="{Binding PreviewWidth}"
                                                           Height="{Binding PreviewHeight}"
                                                           IsInteractive="False"
                                                           State="{Binding SharedState, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}"
                                                           Variant="{Binding Variant}" />
                                </Viewbox>
                                <Border x:Name="AdaptiveDashboardPreview"
                                        Grid.Row="1"
                                        Margin="0,2"
                                        Background="{DynamicResource HerdrOps.Brush.Background}"
                                        BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource HerdrOps.Radius.Default}"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontFamily="{DynamicResource HerdrOps.FontFamily.Icons}"
                                                   Foreground="{DynamicResource HerdrOps.Brush.PrimaryText}"
                                                   FontSize="34"
                                                   Text="&#xE80F;" />
                                        <TextBlock Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding [WidgetDashboardTitle], Source={x:Static localization:UiLanguageService.Shared}}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                                                   FontSize="9"
                                                   Text="{Binding SharedState.DashboardPreviewLabel, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Row="2"
                                        MinHeight="40"
                                        Tag="{Binding Key}"
                                        Style="{DynamicResource HerdrOps.Style.SecondaryButton}"
                                        automation:AutomationProperties.Name="{Binding AutomationName}"
                                        Click="OnOpenWidgetClick"
                                        Content="{Binding ActionLabel}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDashboard}" Value="True">
                                <Setter TargetName="AdaptiveWidgetPreview" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="AdaptiveDashboardPreview" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2"
                    Background="{DynamicResource HerdrOps.Brush.TopBar}"
                    BorderBrush="{DynamicResource HerdrOps.Brush.Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="10"
                               Text="{Binding [WidgetKeyboardShort], Source={x:Static localization:UiLanguageService.Shared}}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource HerdrOps.Brush.TextMuted}"
                               FontSize="10"
                               Text="{Binding SharedState.ConnectionLabel, RelativeSource={RelativeSource AncestorType=widgets:WidgetGalleryView}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
