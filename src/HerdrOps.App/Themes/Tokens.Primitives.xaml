<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Primitive color values sampled from the approved reference set. -->
    <Color x:Key="HerdrOps.Color.Navy.1000">#FF000C19</Color>
    <Color x:Key="HerdrOps.Color.Navy.950">#FF020D19</Color>
    <Color x:Key="HerdrOps.Color.Navy.900">#FF041321</Color>
    <Color x:Key="HerdrOps.Color.Navy.850">#FF061827</Color>
    <Color x:Key="HerdrOps.Color.Navy.800">#FF081D30</Color>
    <Color x:Key="HerdrOps.Color.Navy.750">#FF0D2941</Color>
    <Color x:Key="HerdrOps.Color.Slate.700">#FF17344D</Color>
    <Color x:Key="HerdrOps.Color.Slate.600">#FF25506F</Color>
    <Color x:Key="HerdrOps.Color.Slate.500">#FF53657A</Color>
    <Color x:Key="HerdrOps.Color.Slate.400">#FF718297</Color>
    <Color x:Key="HerdrOps.Color.Slate.300">#FFB8C4D2</Color>
    <Color x:Key="HerdrOps.Color.White.100">#FFF4F7FB</Color>
    <Color x:Key="HerdrOps.Color.Blue.500">#FF149BFF</Color>
    <Color x:Key="HerdrOps.Color.Blue.400">#FF52B8FF</Color>
    <Color x:Key="HerdrOps.Color.Blue.900">#FF082C4A</Color>
    <Color x:Key="HerdrOps.Color.Green.500">#FF2BD47D</Color>
    <Color x:Key="HerdrOps.Color.Amber.500">#FFFFB62E</Color>
    <Color x:Key="HerdrOps.Color.Coral.500">#FFFF5D52</Color>
    <Color x:Key="HerdrOps.Color.Purple.500">#FF8B5CF6</Color>

    <!-- Dense 4 px spacing scale. -->
    <sys:Double x:Key="HerdrOps.Space.1">4</sys:Double>
    <sys:Double x:Key="HerdrOps.Space.2">8</sys:Double>
    <sys:Double x:Key="HerdrOps.Space.3">12</sys:Double>
    <sys:Double x:Key="HerdrOps.Space.4">16</sys:Double>
    <sys:Double x:Key="HerdrOps.Space.5">20</sys:Double>
    <sys:Double x:Key="HerdrOps.Space.6">24</sys:Double>

    <sys:Double x:Key="HerdrOps.FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="HerdrOps.FontSize.BodySmall">13</sys:Double>
    <sys:Double x:Key="HerdrOps.FontSize.Body">15</sys:Double>
    <sys:Double x:Key="HerdrOps.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="HerdrOps.FontSize.Display">28</sys:Double>

    <FontFamily x:Key="HerdrOps.FontFamily.UI">Segoe UI</FontFamily>
    <FontFamily x:Key="HerdrOps.FontFamily.Icons">Segoe Fluent Icons</FontFamily>

    <CornerRadius x:Key="HerdrOps.Radius.Small">5</CornerRadius>
    <CornerRadius x:Key="HerdrOps.Radius.Default">8</CornerRadius>
    <CornerRadius x:Key="HerdrOps.Radius.Large">10</CornerRadius>
    <CornerRadius x:Key="HerdrOps.Radius.Pill">999</CornerRadius>

    <Duration x:Key="HerdrOps.Duration.Fast">0:0:0.15</Duration>
</ResourceDictionary>
