<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HerdrOps.Style.Text.PageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource HerdrOps.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HerdrOps.Style.Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource HerdrOps.FontSize.Body}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HerdrOps.Style.Text.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource HerdrOps.FontSize.Caption}" />
    </Style>

    <Style x:Key="HerdrOps.Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource HerdrOps.Radius.Large}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HerdrOps.Style.ChromeButton" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChromeButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource HerdrOps.Radius.Small}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChromeButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ChromeButtonBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            <Setter TargetName="ChromeButtonBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChromeButtonBorder"
                                    Property="Background"
                                    Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HerdrOps.Style.SecondaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
        <Setter Property="Background" Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HerdrOps.Style.NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="47" />
        <Setter Property="Margin" Value="10,3" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource HerdrOps.Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource HerdrOps.Radius.Default}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource HerdrOps.Brush.SurfaceHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource HerdrOps.Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource HerdrOps.Brush.PrimarySubtle}" />
                            <Setter TargetName="NavItemBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource HerdrOps.Brush.Primary}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="NavItemBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource HerdrOps.Brush.PrimaryText}" />
                            <Setter TargetName="NavItemBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HerdrOps.Style.NavItem.CompactVertical"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource HerdrOps.Style.NavItem}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="10,1" />
    </Style>

    <Style x:Key="HerdrOps.Style.SidebarList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>
</ResourceDictionary>
