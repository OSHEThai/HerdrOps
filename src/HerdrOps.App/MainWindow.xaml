<Window x:Class="HerdrOps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:HerdrOps.App.Views"
        Title="HerdrOps"
        Width="1672"
        Height="941"
        MinWidth="820"
        MinHeight="620"
        Background="{DynamicResource HerdrOps.Brush.Background}"
        Foreground="{DynamicResource HerdrOps.Brush.TextPrimary}"
        FontFamily="{DynamicResource HerdrOps.FontFamily.UI}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="65"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <views:ShellView />
</Window>
